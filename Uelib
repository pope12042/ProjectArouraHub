-- JUJU ANIMATION BREAKER
-- ════════════════════════════════════════════════════════════════
local function DoAnimBreaker()
    local char = LocalPlayer.Character; if not char then return end
    local hum  = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    local now  = tick()
    if now - _abLastUpdate < 0.028 then return end
    _abLastUpdate = now
    local anims = hum:GetPlayingAnimationTracks()
    if _abLag then
        if now - _abFreezeTick > _abLag then
            _abFreezeTick = now
            task.delay(0, function() _abLastFreeze = tick() end)
            _abFreeze = false
        else
            _abFreeze = true
        end
        for _, a in ipairs(anims) do
            if not _abFreeze then _abData[a] = a.TimePosition + now - _abLastFreeze
            else a.TimePosition = (_abData[a] or 0) end
        end
    end
    for _, a in ipairs(anims) do
        if not a.Looped then
            local t = _abTimeData[a]
            if not t then _abTimeData[a] = now
            elseif now - t > a.Length then a:Stop(); _abTimeData[a] = nil end
        end
    end
    if _abJitter then
        for _, a in ipairs(anims) do
            a.TimePosition = a.TimePosition * -math.random(
                math.floor((1 + _abJitter/4) * 100) / 100,
                math.floor((1.5 + _abJitter*4) * 100) / 100
            )
        end
    end
end

local function ToggleAnimBreaker(en)
    _abData = {}; _abTimeData = {}; _abLastUpdate = tick()
    if _abConn then _abConn:Disconnect(); _abConn = nil end
    if en then _abConn = RunService.Heartbeat:Connect(DoAnimBreaker) end
end

