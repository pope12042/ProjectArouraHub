local function InitCrosshair()
    for i = 1, 4 do
        if CrosshairLines[i] then pcall(function() CrosshairLines[i]:Destroy() end) end
        CrosshairLines[i] = Drawing.new("Line")
        CrosshairLines[i].Thickness = 2
    end
    
    CrosshairConnection = RunService.RenderStepped:Connect(function()
        if not Camera then return end
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        if smoothCrosshairCenter == Vector2.new(0, 0) then smoothCrosshairCenter = center end
        
        local targetCrosshairCenter = center
        if Settings.Crosshair.FollowTarget then
            local _ftgt = ActiveRagebotTarget or GetClosestPlayer(false)
            if _ftgt and _ftgt.Character then
                local _flp = _ftgt.Character:FindFirstChild(Settings.SilentAim.LockPart) or _ftgt.Character:FindFirstChild("Head")
                if _flp then
                    local _fsp, _fon = WorldToViewport(_flp.Position)
                    if _fon then targetCrosshairCenter = _fsp end
                end
            end
        elseif Settings.Crosshair.SmartCrosshair then
            local target = GetClosestPlayer(false)
            if target and target.Character then
                local lockPart = target.Character:FindFirstChild(Settings.SilentAim.LockPart) or target.Character:FindFirstChild("Head")
                if lockPart then
                    local sPos, onScreen = WorldToViewport(lockPart.Position)
                    if onScreen then
                        targetCrosshairCenter = Vector2.new(sPos.X, sPos.Y)
                    end
                end
            end
        end
        smoothCrosshairCenter = smoothCrosshairCenter:Lerp(targetCrosshairCenter, 0.15)
        
        local visible = Settings.Crosshair.Enabled
        local currentAngle = Settings.Crosshair.Spinning and (tick() * math.rad(Settings.Crosshair.SpinSpeed)) or 0
        local gap = Settings.Crosshair.Gap + (Settings.Crosshair.Breathing and (math.sin(tick() * 6) * 4) or 0)

        for i = 1, 4 do
            local line = CrosshairLines[i]
            line.Visible = visible
            if visible then
                line.Color = Settings.Crosshair.Color
                local lineAngle = currentAngle + ((i - 1) * (math.pi / 2))
                local direction = Vector2.new(math.cos(lineAngle), math.sin(lineAngle))
                line.From = smoothCrosshairCenter + (direction * gap)
                line.To = smoothCrosshairCenter + (direction * (gap + Settings.Crosshair.Size))
            end
        end
    end)
end

