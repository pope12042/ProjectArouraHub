-- Spawns a visible laser tracer from startPos to endPos (FireServer hook path).
-- Also handles juju beam-event tracers (BULLET_RAYS path) via BeamEnabled flag.
local function CreateTracer(startPos, endPos)
    if not Settings.BulletTracers.Enabled or Settings.BulletTracers.Style == "None" then return end
    local function toVector3(v)
        return typeof(v) == "Vector3" and v
            or (typeof(v) == "CFrame" and v.Position)
            or (typeof(v) == "Instance" and v:IsA("BasePart") and v.Position)
            or nil
    end
    startPos, endPos = toVector3(startPos), toVector3(endPos)
    if not startPos or not endPos then return end
    local distance = (startPos - endPos).Magnitude
    if distance > 2048 or distance < 0.1 then return end

    if Settings.BulletTracers.Style == "Laser" then
        local tracer = Instance.new("Part")
        tracer.Name        = "AuroraTracer"
        tracer.Anchored    = true; tracer.CanCollide = false
        tracer.CanTouch    = false; tracer.CanQuery  = false
        tracer.Material    = Enum.Material.Neon
        tracer.Color       = Settings.BulletTracers.Color
        tracer.Size        = Vector3.new(0.08, 0.08, distance)
        tracer.CFrame      = CFrame.lookAt(startPos, endPos) * CFrame.new(0, 0, -distance / 2)
        tracer.Parent      = Workspace
        task.spawn(function()
            local dur  = Settings.BulletTracers.Duration
            local t0   = tick()
            while tick() - t0 < dur do
                if tracer and tracer.Parent then
                    tracer.Transparency = math.clamp((tick() - t0) / dur, 0, 1)
                else break end
                RunService.RenderStepped:Wait()
            end
            if tracer and tracer.Parent then tracer:Destroy() end
        end)
    end
end

-- Juju beam tracer — called from the BULLET_RAYS hook below.
-- Lives here (same section as CreateTracer) so both paths are in one place.
local function CreateBeamTracer(worldCFrame, isLocal)
    if not Settings.BulletTracers.BeamEnabled then return end
    if isLocal     and not Settings.BulletTracers.ShowLocal  then return end
    if not isLocal and not Settings.BulletTracers.ShowOthers then return end
    local startPos = Camera and Camera.CFrame.Position or Vector3.new(0, 0, 0)
    local endPos   = worldCFrame.Position
    local d = (startPos - endPos).Magnitude
    if d > 4096 or d < 0.1 then return end
    local t = Instance.new("Part")
    t.Name      = "AuroraBeamTracer"; t.Anchored   = true
    t.CanCollide = false; t.CanTouch  = false; t.CanQuery = false
    t.Material  = Enum.Material.Neon
    t.Color     = Settings.BulletTracers.BeamColor
    t.Size      = Vector3.new(0.07, 0.07, d)
    t.CFrame    = CFrame.lookAt(startPos, endPos) * CFrame.new(0, 0, -d / 2)
    t.Parent    = Workspace
    task.spawn(function()
        local dur = Settings.BulletTracers.BeamDuration
        local t0  = tick()
        while tick() - t0 < dur do
            if t and t.Parent then
                t.Transparency = math.clamp((tick() - t0) / dur, 0, 1)
            else break end
            RunService.RenderStepped:Wait()
        end
        if t and t.Parent then t:Destroy() end
    end)
end

-- BULLET_RAYS hook — fires CreateBeamTracer whenever the game spawns a beam object
local function StartBeamTracerHook()
    local ok, ignored = pcall(function() return Workspace:FindFirstChild("Ignored") end)
    if not ok or not ignored then return end
    local siren = ignored:FindFirstChild("Siren"); if not siren then return end
    local radius = siren:FindFirstChild("Radius"); if not radius then return end
    _jujuTracerFolder = radius
    if _jujuTracerConnection then _jujuTracerConnection:Disconnect() end
    _jujuTracerConnection = radius.ChildAdded:Connect(function(obj)
        task.wait()
        if obj.Name ~= "BULLET_RAYS" then return end
        local beam = obj:FindFirstChildOfClass("Beam")
        if beam and beam.Attachment1 then
            local wcf   = beam.Attachment1.WorldCFrame
            local owner = obj:GetAttribute("OwnerCharacter")
            CreateBeamTracer(wcf, owner == LocalPlayer.Name)
        end
    end)
end
task.spawn(function()
    for _ = 1, 30 do
        pcall(StartBeamTracerHook)
        if _jujuTracerFolder then break end
        task.wait(1)
    end
end)

