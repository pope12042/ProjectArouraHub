local _streamProofConn = nil
local function ApplyStreamProof(en)
    pcall(function()
        local sg = safeRef(CoreGui)
        if sg then
            -- Attempts to make the GUI invisible to screen capture software.
            -- Not guaranteed to work on all exploits; depends on renderer support.
            if en then
                sg.ScreenCapturePolicy = Enum.ScreenCapturePolicy.ScreenOnly
            else
                sg.ScreenCapturePolicy = Enum.ScreenCapturePolicy.Default
            end
        end
    end)
end

