local function CreateDamageIndicator(character, damageAmount)
    if not Settings.DamageIndicators.Enabled or not character then return end
    local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
    if not head then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "AuroraDamageIndicator"
    billboard.Size = UDim2.new(0, 100, 0, 40)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 1000
    billboard.ExtentsOffset = Vector3.new(math.random(-2, 2), 2, math.random(-2, 2))
    billboard.Parent = head

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = tostring(damageAmount)
    label.TextSize = 28
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)

    if Settings.DamageIndicators.Style == "unnamed Enhancements" then
        label.Font = Enum.Font.SciFi
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
    elseif Settings.DamageIndicators.Style == "fortnite" then
        label.Font = Enum.Font.LuckiestGuy
        label.TextColor3 = Settings.DamageIndicators.Color
    end

    label.Parent = billboard

    task.spawn(function()
        local duration = 1.2
        local startTime = tick()
        while tick() - startTime < duration do
            local elapsed = tick() - startTime
            local progress = elapsed / duration
            billboard.ExtentsOffset = billboard.ExtentsOffset + Vector3.new(0, 2.5 * RunService.RenderStepped:Wait(), 0)
            label.TextTransparency = progress
            label.TextStrokeTransparency = progress
        end
        billboard:Destroy()
    end)
end

