            local MaxX = math.ceil(Library:MapValue(MultiSlider.MaxValue, MultiSlider.Min, MultiSlider.Max, 0, MultiSlider.MaxMaxSize));
            
            getgenv().UnnamedFeaturesSetSliderFill(MinSlider.Fill, MinX);
