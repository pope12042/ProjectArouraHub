            if thrp and (lhrp.Position - thrp.Position).Magnitude < 50 then
                if Settings.SafePurchasing.AvoidEnemy  then return false end
                if Settings.SafePurchasing.AvoidTarget and p == ActiveRagebotTarget then return false end
