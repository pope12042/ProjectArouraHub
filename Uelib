local function ToggleNetworkDesync(en)
    if network_desync_conn then network_desync_conn:Disconnect(); network_desync_conn = nil end
    if not en then return end
    network_desync_conn = RunService.Heartbeat:Connect(function()
        if not Settings.NetworkDesync.Enabled then return end
        local lhrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not lhrp then return end
        local real = lhrp.CFrame
        lhrp.CFrame = real * CFrame.new(math.random(-20,20), math.random(-2,2), math.random(-20,20))
        RunService.Heartbeat:Wait()
        lhrp.CFrame = real
    end)
end

local function ToggleVelocityDesync(en)
    if vel_desync_conn then vel_desync_conn:Disconnect(); vel_desync_conn = nil end
    if not en then return end
    vel_desync_conn = RunService.Heartbeat:Connect(function()
        if not Settings.VelocityDesync.Enabled then return end
        local lhrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not lhrp then return end
        local realVel = lhrp.AssemblyLinearVelocity
        local t = Settings.VelocityDesync.Type
        if     t == "high"   then lhrp.AssemblyLinearVelocity = Vector3.new(math.random(-9e5,9e5),math.random(-9e5,9e5),math.random(-9e5,9e5))
        elseif t == "high y" then lhrp.AssemblyLinearVelocity = Vector3.new(realVel.X, math.random(9e4,9e5), realVel.Z)
        elseif t == "zero"   then lhrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
        elseif t == "low"    then lhrp.AssemblyLinearVelocity = Vector3.new(math.random(-1,1),math.random(-1,1),math.random(-1,1))
        end
        if Settings.VelocityDesync.Rotate then
            lhrp.CFrame = lhrp.CFrame * CFrame.Angles(0, math.rad(math.random(0,360)), 0)
        end
        RunService.Heartbeat:Wait()
        lhrp.AssemblyLinearVelocity = realVel
    end)
end

local function ToggleVoidHide(en)
    if void_hide_conn then void_hide_conn:Disconnect(); void_hide_conn = nil end
    if not en then return end
    void_hide_conn = RunService.Heartbeat:Connect(function()
        if not Settings.VoidHide.Enabled then return end
        if purchasing or local_following then return end
        local lhrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not lhrp then return end
        local real = lhrp.CFrame
        local voidPos
        if Settings.VoidHide.Type == "bait" then
            local tgt = ActiveRagebotTarget
            local thrp = tgt and tgt.Character and tgt.Character:FindFirstChild("HumanoidRootPart")
            if thrp then
                local dir = (lhrp.Position - thrp.Position).Unit
                voidPos = lhrp.Position + dir * 250 + Vector3.new(0, 9e5, 0)
            else
                voidPos = lhrp.Position + Vector3.new(0, 9e5, 0)
            end
        else
            voidPos = lhrp.Position + Vector3.new(math.random(-2e6,2e6), math.random(9e5,2e6), math.random(-2e6,2e6))
        end
        lhrp.CFrame = CFrame.new(voidPos)
        task.wait(Settings.VoidHide.VoidTime)
        if lhrp and lhrp.Parent then lhrp.CFrame = real end
        task.wait(Settings.VoidHide.TeleportTime)
    end)
end

