local function WorldToViewport(pos)
    if not Camera then return Vector2.new(0, 0), false end
    local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen
end

local function UpdateEnvironmentLighting()
    if Settings.WorldColor.Enabled then
        ColorCorrection.TintColor = Settings.WorldColor.Color
        Lighting.Ambient = Settings.WorldColor.Color
    else
        ColorCorrection.TintColor = OriginalTintColor
        Lighting.Ambient = OriginalAmbient
    end
    Bloom.Enabled = Settings.Bloom.Enabled
    if Settings.Bloom.Enabled then
        Bloom.Intensity = 1.25
        Bloom.Threshold = 0.05
        if not Settings.WorldColor.Enabled then ColorCorrection.TintColor = Settings.Bloom.Color end
    end
end

local function ResetHitboxes()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root and root:IsA("BasePart") and root:GetAttribute("OriginalSize") then
                root.Size = root:GetAttribute("OriginalSize")
                root.CanCollide = root:GetAttribute("OriginalCanCollide")
                root.Transparency = root:GetAttribute("OriginalTransparency")
            end
        end
    end
end

