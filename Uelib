local function GetCharacter() return LocalPlayer.Character end
local function GetRootPart() local character = GetCharacter() return character and character:FindFirstChild("HumanoidRootPart") end

local function IsVisible(targetPart, targetCharacter)
    if not Camera then return false end
    local charactersToIgnore = {LocalPlayer.Character, targetCharacter}
    local partsObscuring = Camera:GetPartsObscuringTarget({targetPart.Position}, charactersToIgnore)
    return #partsObscuring == 0
end

local function GetAbsoluteNearestPlayerWorld()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local root = GetRootPart()
    if not root then return nil end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            local targetPart = player.Character:FindFirstChild("HumanoidRootPart")
            if humanoid and humanoid.Health > 0 and targetPart then
                local distance = (root.Position - targetPart.Position).Magnitude
                if distance < shortestDistance then
                    closestPlayer = player
                    shortestDistance = distance
                end
            end
        end
    end
    return closestPlayer
end

local function GetClosestPlayer(checkWall)
    local closestPlayer = nil
    if Settings.SilentAim.TargetType == "Nearest" then
        local shortestDistance = math.huge
        local root = GetRootPart()
        if not root then return nil end
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                if Settings.SilentAim.TeamTarget == "Enemies" and player.Team == LocalPlayer.Team then continue end
                if Settings.SilentAim.TeamTarget == "Allies" and player.Team ~= LocalPlayer.Team then continue end
                local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                local targetPart = player.Character:FindFirstChild(Settings.SilentAim.LockPart) or player.Character:FindFirstChild("HumanoidRootPart")
                if humanoid and humanoid.Health > 0 and targetPart then
                    if checkWall and not IsVisible(targetPart, player.Character) then continue end
                    local distance = (root.Position - targetPart.Position).Magnitude
                    if distance < shortestDistance then
                        closestPlayer = player
                        shortestDistance = distance
                    end
                end
            end
        end
        return closestPlayer
    else
        local shortestDistance = Settings.FOVCircle.Enabled and Settings.FOVCircle.Size or math.huge
        if not Camera then return closestPlayer end
        local centerPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                if Settings.SilentAim.TeamTarget == "Enemies" and player.Team == LocalPlayer.Team then continue end
                if Settings.SilentAim.TeamTarget == "Allies" and player.Team ~= LocalPlayer.Team then continue end
                
                local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
                local targetPart = player.Character:FindFirstChild(Settings.SilentAim.LockPart) or rootPart
                
                if humanoid and humanoid.Health > 0 and targetPart then
                    if checkWall and not IsVisible(targetPart, player.Character) then continue end
                    
                    local screenPos, onScreen = WorldToViewport(targetPart.Position)
                    if onScreen then
                        local distance = (Vector2.new(screenPos.X, screenPos.Y) - centerPos).Magnitude
                        if distance < shortestDistance then
                            closestPlayer = player
                            shortestDistance = distance
                        end
                    end
                end
            end
        end
        return closestPlayer
    end
end

local function IsLookingAtPlayer(player)
    if not Camera or not player.Character then return false end
    local head = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")
    if not head then return false end
    local dirToPlayer = (head.Position - Camera.CFrame.Position).Unit
    local lookDir = Camera.CFrame.LookVector
    local dot = dirToPlayer:Dot(lookDir)
    return dot > 0.8
end

