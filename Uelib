    end;
end;

function Library:MapValue(Value, MinA, MaxA, MinB, MaxB)
    return (1 - ((Value - MinA) / (MaxA - MinA))) * MinB + ((Value - MinA) / (MaxA - MinA)) * MaxB;
end;

function Library:GetTextBounds(Text, Font, Size, Resolution)
    local checkFont = Font;
    if typeof(Font) == 'Font' then
        checkFont = Enum.Font.Roboto;
    end
    local Bounds = TextService:GetTextSize(Text, Size, checkFont, Resolution or Vector2.new(1920, 1080))
    return Bounds.X, Bounds.Y
end;

function Library:GetDarkerColor(Color)
    local H, S, V = Color3.toHSV(Color);
    return Color3.fromHSV(H, S, V / 1.5);
end;
Library.AccentColorDark = Library:GetDarkerColor(Library.AccentColor);

function Library:AddToRegistry(UnnamedFeatures, Properties, IsHud)
    local Idx = #Library.Registry + 1;
    local Data = {
        UnnamedFeatures = UnnamedFeatures;
        Properties = Properties;
        Idx = Idx;
    };

    table.insert(Library.Registry, Data);
    Library.RegistryMap[UnnamedFeatures] = Data;

    if IsHud then
        table.insert(Library.HudRegistry, Data);
    end;
end;

function Library:RemoveFromRegistry(UnnamedFeatures)
    local Data = Library.RegistryMap[UnnamedFeatures];

    if Data then
        for Idx = #Library.Registry, 1, -1 do
            if Library.Registry[Idx] == Data then
                table.remove(Library.Registry, Idx);
            end;
        end;

        for Idx = #Library.HudRegistry, 1, -1 do
            if Library.HudRegistry[Idx] == Data then
                table.remove(Library.HudRegistry, Idx);
            end;
        end;

        Library.RegistryMap[UnnamedFeatures] = nil;
    end;
end;

function Library:UpdateColorsUsingRegistry()
    for Idx, Object in next, Library.Registry do
        for Property, ColorIdx in next, Object.Properties do
            if type(ColorIdx) == 'string' then
                Object.UnnamedFeatures[Property] = Library[ColorIdx];
            elseif type(ColorIdx) == 'function' then
                Object.UnnamedFeatures[Property] = ColorIdx()
            end
        end;
    end;

    for _, Toggle in next, Toggles do
        if Toggle.Value and Toggle.Display then
            Toggle:Display();
        end;
    end;
end;



function Library:GiveSignal(Signal)
    -- Only used for signals not attached to library UnnamedFeaturess, as those should be cleaned up on object destruction by Roblox
    table.insert(Library.Signals, Signal)
end

function Library:Unload()
    -- Unload all of the signals
    for Idx = #Library.Signals, 1, -1 do
        local Connection = table.remove(Library.Signals, Idx)
        Connection:Disconnect()
    end

     -- Call our unload callback, maybe to undo some hooks etc
    if Library.OnUnload then
        Library.OnUnload()
    end

    ScreenGui:Destroy()
end

function Library:OnUnload(Callback)
    Library.OnUnload = Callback
end

