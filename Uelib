                local angle = math.atan2(-camSpace.X, camSpace.Z)
                local borderPadding = 60
                local posX = center.X + math.sin(angle) * (center.X - borderPadding)
                local posY = center.Y + math.cos(angle) * (center.Y - borderPadding)
                calculatedPos2D = Vector2.new(posX, posY)
            end
            
