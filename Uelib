                end
            end
        end
    end)
end

local function CreateESP(player)
    if ESPObjects[player] then return end
    local container = { Box = Drawing.new("Square"), HealthBarBack = Drawing.new("Square"), HealthBarFill = Drawing.new("Square"), Name = Drawing.new("Text"), Tool = Drawing.new("Text") }
    container.Box.Filled = false; container.Box.Thickness = 1
    container.HealthBarBack.Filled = true; container.HealthBarBack.Thickness = 0; container.HealthBarBack.Color = Color3.fromRGB(40, 40, 40)
    container.HealthBarFill.Filled = true; container.HealthBarFill.Thickness = 0
    container.Name.Size = 14; container.Name.Center = true; container.Name.Outline = true
    container.Tool.Size = 14; container.Tool.Center = true; container.Tool.Outline = true
    ESPObjects[player] = container
    
    local renderConnection
    renderConnection = RunService.RenderStepped:Connect(function()
        if not player or not player.Parent then
            for _, d in pairs(container) do pcall(function() d:Destroy() end) end
            renderConnection:Disconnect(); return
        end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        
        if char and root and hum and hum.Health > 0 then
            local coords, visible = WorldToViewport(root.Position)
            if visible then
                local topPoints = WorldToViewport(root.Position + Vector3.new(0, 3, 0))
                local bottomPoints = WorldToViewport(root.Position - Vector3.new(0, 3.5, 0))
                local boxHeight = math.abs(topPoints.Y - bottomPoints.Y)
                local boxWidth = boxHeight * 0.6
                local boxX, boxY = coords.X - (boxWidth / 2), coords.Y - (boxHeight / 2)
                
                container.Box.Visible = Settings.ESP.Box.Enabled
                if Settings.ESP.Box.Enabled then container.Box.Size = Vector2.new(boxWidth, boxHeight); container.Box.Position = Vector2.new(boxX, boxY); container.Box.Color = Settings.ESP.Box.Color end
                
                local healthActive = Settings.ESP.HealthBar.Enabled
                container.HealthBarBack.Visible = healthActive; container.HealthBarFill.Visible = healthActive
                if healthActive then
                    container.HealthBarBack.Size = Vector2.new(3, boxHeight); container.HealthBarBack.Position = Vector2.new(boxX - 7, boxY)
                    local Factor = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    container.HealthBarFill.Size = Vector2.new(3, boxHeight * Factor); container.HealthBarFill.Position = Vector2.new(boxX - 7, boxY + (boxHeight - (boxHeight * Factor)))
                    container.HealthBarFill.Color = Settings.ESP.HealthBar.Rainbow and Color3.fromHSV(GlobalHue, 1, 1) or Color3.fromRGB(255 - (255 * Factor), 255 * Factor, 0)
                end
                
                container.Name.Visible = Settings.ESP.Name.Enabled
                if Settings.ESP.Name.Enabled then container.Name.Position = Vector2.new(coords.X, boxY - 16); container.Name.Text = player.Name; container.Name.Color = Color3.fromRGB(255, 255, 255) end
                
                container.Tool.Visible = Settings.ESP.Tool.Enabled
                if Settings.ESP.Tool.Enabled then
                    local currentTool = char:FindFirstChildOfClass("Tool")
                    container.Tool.Text = currentTool and currentTool.Name or "None"
                    container.Tool.Position = Vector2.new(coords.X, boxY + boxHeight + 2)
                    container.Tool.Color = Color3.fromRGB(255, 255, 255)
                end
                return
            end
        end
        for _, d in pairs(container) do d.Visible = false end
    end)
end

