PlayerManagementGroup:AddButton("Fling & Activate Item", function()
    task.spawn(function()
        task.wait(0.7)
        if Settings.SelectedPlayer and Settings.SelectedPlayer ~= "" then
            local target = Players:FindFirstChild(Settings.SelectedPlayer)
            local localHRP = GetRootPart()
            local character = GetCharacter()
            if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and localHRP then
                local targetHRP = target.Character.HumanoidRootPart
                local originalCFrame = localHRP.CFrame
                
                local flingActive = true
                local startTime = tick()
                local connection
                connection = RunService.Heartbeat:Connect(function()
                    local targetHum = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
                    local targetFlung = targetHRP and targetHRP.Velocity.Magnitude > 150
                    local isDead = targetHum and targetHum.Health <= 0
                    
                    if (tick() - startTime > 4.0) or targetFlung or isDead or not targetHRP or not localHRP then
                        flingActive = false
                        connection:Disconnect()
                        localHRP.CFrame = originalCFrame
                        localHRP.Velocity = Vector3.new(0, 0, 0)
                        localHRP.RotVelocity = Vector3.new(0, 0, 0)
                        return
                    end
                    localHRP.Velocity = Vector3.new(99999, 99999, 99999)
                    localHRP.RotVelocity = Vector3.new(99999, 99999, 99999)
                    localHRP.CFrame = targetHRP.CFrame * CFrame.new(math.random(-1, 1), 0, math.random(-1, 1))
                    
                    local tool = character and character:FindFirstChildOfClass("Tool")
                    if tool then
                        tool:Activate()
                    end
                end)
                
                while flingActive do task.wait() end
            end
        end
        
        local char = GetCharacter()
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                for i = 1, 5 do
                    tool:Activate()
                    task.wait()
                end
            end
        end
    end)
end)

