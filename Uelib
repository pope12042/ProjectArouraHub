function Library:Create(Class, Properties)
    local _UnnamedFeatures = Class;

    if type(Class) == 'string' then
        _UnnamedFeatures = Instance.new(Class);
    end;

    for Property, Value in next, Properties do
        if Property == 'Font' then
            if typeof(Value) == 'Font' then
                _UnnamedFeatures.FontFace = Value;
            elseif typeof(Value) == 'EnumItem' then
                _UnnamedFeatures.Font = Value;
            end
        else
            _UnnamedFeatures[Property] = Value;
        end;
    end;

    return _UnnamedFeatures;
end;

