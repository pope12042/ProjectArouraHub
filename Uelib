local _customMouseGui = nil
local _customMouseLabel = nil
local _customMouseConn = nil

local function ToggleCustomMouse(en)
    if _customMouseConn then _customMouseConn:Disconnect(); _customMouseConn = nil end
    if _customMouseGui  then pcall(function() _customMouseGui:Destroy() end); _customMouseGui = nil end

    if not en then
        -- Restore system cursor
        pcall(function() UserInputService.MouseIconEnabled = true end)
        return
    end

    -- Hide system cursor, draw our own
    pcall(function() UserInputService.MouseIconEnabled = false end)

    _customMouseGui = Instance.new("ScreenGui")
    _customMouseGui.Name = "ArouraCustomMouse"
    _customMouseGui.ResetOnSpawn = false
    _customMouseGui.IgnoreGuiInset = true
    _customMouseGui.DisplayOrder = 999
    pcall(function() _customMouseGui.Parent = safeRef(CoreGui) end)
    if not _customMouseGui.Parent then
        _customMouseGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end

    _customMouseLabel = Instance.new("ImageLabel")
    _customMouseLabel.Size = UDim2.new(0, Settings.CustomMouse.Size, 0, Settings.CustomMouse.Size)
    _customMouseLabel.AnchorPoint = Vector2.new(0.5, 0.5)
    _customMouseLabel.BackgroundTransparency = 1
    _customMouseLabel.ImageColor3 = Settings.CustomMouse.Color
    -- Use custom image if set, otherwise draw a simple dot
    if Settings.CustomMouse.ImageId ~= "" and Settings.CustomMouse.ImageId ~= "rbxassetid://0" then
        _customMouseLabel.Image = Settings.CustomMouse.ImageId
    else
        _customMouseLabel.Image = ""
        -- Fall back to a plain circle via UICorner
        local bg = Instance.new("Frame")
        bg.Size = UDim2.new(1, 0, 1, 0)
        bg.BackgroundColor3 = Settings.CustomMouse.Color
        bg.BorderSizePixel = 0
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = bg
        bg.Parent = _customMouseLabel
    end
    _customMouseLabel.Parent = _customMouseGui

    _customMouseConn = RunService.RenderStepped:Connect(function()
        if not Settings.CustomMouse.Enabled then
            ToggleCustomMouse(false); return
        end
        local mp = UserInputService:GetMouseLocation()
        _customMouseLabel.Position = UDim2.new(0, mp.X, 0, mp.Y)
        _customMouseLabel.Size = UDim2.new(0, Settings.CustomMouse.Size, 0, Settings.CustomMouse.Size)
        _customMouseLabel.ImageColor3 = Settings.CustomMouse.Color
    end)
end

local random = math.random
local Vector3new = Vector3.new
local CFramenew = CFrame.new
local gsub = string.gsub
local sub = string.sub
local upper = string.upper
local Mouse = LocalPlayer:GetMouse()

local Hooks = {
    HookedFunctions = {},
    OldMetaMethods = {},
    MetaMethodHooks = {},
    HookedSignals = {}
}

local HookedFunctions = Hooks.HookedFunctions
local MetaMethodHooks = Hooks.MetaMethodHooks
local OldMetaMethods = Hooks.OldMetaMethods

local randomised = random(1, 10);
local randomisedVector = Vector3new(random(1, 10), random(1, 10), random(1, 10));
Mouse.Move:Connect(function()
    randomised = random(1, 10);
    randomisedVector = Vector3new(random(1, 10), random(1, 10), random(1, 10));
end);

MetaMethodHooks.Index = function(...)
    local __Index = OldMetaMethods.__index
    local self, Index = ...

    if (Settings.SilentAim.Enabled and self == Mouse and not checkcaller()) then
        local target = GetClosestPlayer(Settings.SilentAim.WallCheck)
        if target and target.Character then
            local Aimlock = target.Character:FindFirstChild(Settings.SilentAim.LockPart) or target.Character:FindFirstChild("Head")
            local ClosestCharacter = target.Character
            
            if Aimlock then
                local CallingScript = getfenv(2).script;
                if (CallingScript and CallingScript.Name == "CallingScript") then
                    return __Index(...);
                end

                if (type(Index) == 'string') then
                    Index = gsub(sub(Index, 0, 100), "%z.*", "");
                end
                
                local PassedChance = random(1, 100) <= Settings.SilentAim.HitChance
                if (PassedChance) then
                    local Parts = Camera:GetPartsObscuringTarget({Camera.CFrame.Position, Aimlock.Position}, {LocalPlayer.Character, ClosestCharacter});

                    Index = string.gsub(Index, "^%l", upper);
                    local Hit = #Parts == 0 or (not Settings.SilentAim.WallCheck)
                    if (not Hit) then
                        return __Index(...);
                    end
                    if (Index == "Target") then
                        return Aimlock
                    end
                    if (Index == "Hit") then
                        local hit = __Index(...);
                        local pos = Aimlock.Position + (Aimlock.Velocity * Settings.SilentAim.Prediction) + (randomisedVector / 10)
                        return CFramenew(pos.X, pos.Y, pos.Z, unpack({hit:components()}, 4));
                    end
                    if (Index == "X") then
                        local sPos, onScreen = WorldToViewport(Aimlock.Position)
                        return sPos.X + randomised / 10
                    end
                    if (Index == "Y") then
                        local sPos, onScreen = WorldToViewport(Aimlock.Position)
                        return sPos.Y + randomised / 10
                    end
                end
            end
        end
    end

    return __Index(...);
end

MetaMethodHooks.Namecall = function(...)
    local __Namecall = OldMetaMethods.__namecall
    local self = ...
    local Method = gsub(getnamecallmethod() or "", "^%l", upper);
    
    local Hooked = HookedFunctions[Method]
    if (Hooked and self == Hooked[1]) then
        return Hooked[3](...);
    end

    if Method == "FireServer" and not checkcaller() then
        local args = {select(2, ...)}
        local isShootEvent = (self.Name == "ShootEvent")
        local isMainEvent = (self.Name == "MainEvent" and args[1] == "UpdateMousePos")
        
        if isShootEvent or isMainEvent then
            LastAttackTime = tick()
            local targetPosIndex = isShootEvent and 1 or 2
            local targetPosition = args[targetPosIndex]
            
            if Settings.SilentAim.Enabled or Settings.SilentAim.MagicBullet then
                local target = GetClosestPlayer(not Settings.SilentAim.MagicBullet and Settings.SilentAim.WallCheck)
                if target and target.Character then
                    local targetPart = target.Character:FindFirstChild(Settings.SilentAim.LockPart) or target.Character:FindFirstChild("Head")
                    local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
                    
                    if targetPart then 
                        targetPosition = targetPart.Position + (targetPart.Velocity * Settings.SilentAim.Prediction) 
                        args[targetPosIndex] = targetPosition
                    end
                    
                    if Settings.SilentAim.MagicBullet and targetRoot then
                        local root = GetRootPart()
                        if root then
                            local oldCFrame = root.CFrame
                            root.CFrame = targetRoot.CFrame * CFrame.new(0, 0, -3) * CFrame.Angles(0, math.pi, 0)
                            local newArgs = {self, unpack(args)}
                            local result = __Namecall(unpack(newArgs))
                            root.CFrame = oldCFrame
                            if Settings.BulletTracers.Enabled and targetPosition then 
                                task.spawn(CreateTracer, GetAbsoluteMuzzle(), targetPosition) 
                            end
                            return result
                        end
                    end
                end
            end
            
            if Settings.BulletTracers.Enabled and targetPosition then 
                task.spawn(CreateTracer, GetAbsoluteMuzzle(), targetPosition) 
            end
            local newArgs = {self, unpack(args)}
            return __Namecall(unpack(newArgs))
        elseif self.Name == "RecoilEvent" and Settings.NoRecoil.Enabled then 
            return 
        end
    end

    return __Namecall(...);
end

for MMName, MMFunc in pairs(MetaMethodHooks) do
    local MetaMethod = string.format("__%s", string.lower(MMName));
    Hooks.OldMetaMethods[MetaMethod] = hookmetamethod(game, MetaMethod, MMFunc);
end

