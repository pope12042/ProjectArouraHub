Library:OnUnload(function()
    if SpinbotConnection then SpinbotConnection:Disconnect() end
    if FakePosConnection then FakePosConnection:Disconnect() end
    if AutoShootConnection then AutoShootConnection:Disconnect() end
    if RainbowGunConnection then RainbowGunConnection:Disconnect() end
    if CrosshairConnection then CrosshairConnection:Disconnect() end
    if AimAssistConnection then AimAssistConnection:Disconnect() end
    if FlyjumpConnection then FlyjumpConnection:Disconnect() end
    if FOVCircleOutline then pcall(function() FOVCircleOutline:Destroy() end) end
    if FOVCircleFill then pcall(function() FOVCircleFill:Destroy() end) end
    if StatusGui then pcall(function() StatusGui:Destroy() end) end
    if KillAuraVisualTracer then pcall(function() KillAuraVisualTracer:Destroy() end) end
    if SnowHost then pcall(function() SnowHost:Destroy() end) end
    if getgenv().ArouraSnow then pcall(function() getgenv().ArouraSnow:Destroy() end) end
    if NearestESPHighlight then pcall(function() NearestESPHighlight:Destroy() end) end
    if MyDesyncVisualizer then pcall(function() MyDesyncVisualizer:Destroy() end) end
    
    -- Target Visualizer Cleanups
    if TargetHighlight then pcall(function() TargetHighlight:Destroy() end) end
    if TargetTracerLine then pcall(function() TargetTracerLine:Remove() end) end
    if TargetIndicatorGui then pcall(function() TargetIndicatorGui:Destroy() end) end
    if TargetCircle3D then pcall(function() TargetCircle3D.Adornee = nil end) end
    -- Juju connection cleanup
    for _, _c in ipairs({
        _autoFireConn, _autoEquipConn, _spamResolverConn,
        follow_target_conn, auto_stomp_conn, auto_ammo_conn,
        auto_armor_conn, anti_stomp_conn, auto_mask_conn,
        auto_heal_conn, anti_taser_conn, rapid_fire_conn,
        auto_loadout_conn, void_hide_conn, network_desync_conn,
        vel_desync_conn, sender_rate_conn, _abConn,
        _jujuTracerConnection, _emoteMoveConn,
    }) do if _c then pcall(function() _c:Disconnect() end) end end
    StopJujuEmote()
    ToggleCustomMouse(false)
    ApplyStreamProof(false)

    if HookedFunctions.FindPartOnRay and HookedFunctions.FindPartOnRay[4] then
        hookfunction(HookedFunctions.FindPartOnRay[2], HookedFunctions.FindPartOnRay[4])
    end
    if HookedFunctions.FindPartOnRayWithIgnoreList and HookedFunctions.FindPartOnRayWithIgnoreList[4] then
        hookfunction(HookedFunctions.FindPartOnRayWithIgnoreList[2], HookedFunctions.FindPartOnRayWithIgnoreList[4])
    end
    
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        Camera.CameraSubject = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    end
    
    ResetHitboxes()
    
    ColorCorrection.TintColor = OriginalTintColor; Lighting.Ambient = OriginalAmbient
    LocalPlayer.DisplayName = OriginalDisplayName; pcall(function() LocalPlayer.Name = OriginalName end)
    for _, l in pairs(CrosshairLines) do pcall(function() l:Destroy() end) end
    for player, _ in pairs(ESPObjects) do RemoveESP(player) end
    Library.Unloaded = true
end)

