    if not damageToken then return end
    local packet = table.pack(...)
    local myId = localObjectId()
    if not myId then return end
    for index = 3, packet.n do
        if packet[index] == damageToken then
            local objectId = packet[index - 1]
            if index == 4 then
                objectId = packet[2]
            end
            if objectId == myId then
                local hitPart = packet[index + 1]
                local damage = packet[index + 2]
                local isHead = packet[index + 3]
