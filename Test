-- Fighter / item resolution
local function ResolveFighterController()
    local ps = LP:FindFirstChild("PlayerScripts")
    local ctrls = ps and ps:FindFirstChild("Controllers")
    local m = ctrls and ctrls:FindFirstChild("FighterController")
    if m then local ok, c = pcall(require, m); if ok then return c end end
    return nil
end
local function ResolveLocalFighter()
    local fc = ResolveFighterController()
    if fc and fc.LocalFighter then return fc.LocalFighter end
    if fc and type(fc.GetFighter) == "function" then
        local f = fc:GetFighter(LP)
        if f then return f end
        if LP.Character then return fc:GetFighter(LP.Character) end
    end
    return nil
end
local function GetLocalEquippedItem()
    local f = ResolveLocalFighter()
    return f and f.EquippedItem or nil
end
local function IsEnemyTeam(player)
    if player == LP then return false end
    local myT = LP:GetAttribute("TeamID"); local tT = player:GetAttribute("TeamID")
    if myT and tT then return myT ~= tT end
    if player.Team and LP.Team then return player.Team ~= LP.Team end
    return true
end

