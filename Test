oldNamecall=hookmetamethod(game,"__namecall",function(self,...)
    local method=getnamecallmethod()
    if method=="Kick" and self==LocalPlayer then return end
    if method=="FireServer" or method=="InvokeServer" then
        local name=self.Name:lower()
        if name:find("exploit") or name:find("cheat") or name:find("detect") or name:find("ban") or name:find("flag") or name:find("validate") or name:find("integrity") or name:find("security") or name:find("anticheat") or name:find("ac_") then return end
        if SHOOT_STATE.remote and self==SHOOT_STATE.remote and SHOOT_STATE.getTarget then
            local targetPart=SHOOT_STATE.getTarget()
            if targetPart then
                local char=LocalPlayer.Character
                local root=char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    local origin=root.Position+Vector3.new(0,1.5,0)
                    local targetPos=targetPart.Position
                    local direction=(targetPos-origin).Unit
                    local distance=(targetPos-origin).Magnitude
                    local args={...}
                    for i,arg in ipairs(args) do
                        if typeof(arg)=="Vector3" then args[i]=(i==1 or typeof(args[i-1])~="Vector3") and origin or direction
                        elseif typeof(arg)=="CFrame" then args[i]=CFrame.new(origin,targetPos)
                        elseif typeof(arg)=="Instance" and arg:IsA("BasePart") then args[i]=targetPart
                        elseif type(arg)=="number" and arg>10 and arg<5000 then args[i]=distance
                        elseif type(arg)=="table" then
                            for _,key in ipairs({"Origin","origin","Start","start","From","from","Position","position"}) do if rawget(arg,key) and typeof(rawget(arg,key))=="Vector3" then arg[key]=origin end end
                            for _,key in ipairs({"Direction","direction","Dir","dir","LookVector","lookVector"}) do if rawget(arg,key) and typeof(rawget(arg,key))=="Vector3" then arg[key]=direction end end
                            for _,key in ipairs({"HitPart","hitPart","Hit","hit","Target","target","Part","part","Instance","instance"}) do if rawget(arg,key) and typeof(rawget(arg,key))=="Instance" then arg[key]=targetPart end end
                            for _,key in ipairs({"Distance","distance","Dist","dist","Range","range","Magnitude","magnitude"}) do if rawget(arg,key) and type(rawget(arg,key))=="number" then arg[key]=distance end end
                            for _,key in ipairs({"CFrame","cframe","CF","cf","LookCFrame","lookCFrame"}) do if rawget(arg,key) and typeof(rawget(arg,key))=="CFrame" then arg[key]=CFrame.new(origin,targetPos) end end
                        end
                    end
                    return oldNamecall(self,unpack(args))
                end
            end
        end
        if UnlockActive and UNLOCK.equipRem and self==UNLOCK.equipRem then
            local a={...} local wn,ct,cn,opts=a[1],a[2],a[3],a[4] or {}
