-- // 6. Gun info / gun tip / camera controller helpers (UNCHANGED)
local CameraControllerModule = nil
local function ResolveCameraController()
    if CameraControllerModule then return CameraControllerModule end
    local ok, mod = pcall(function()
        return require(LocalPlayer.PlayerScripts.Controllers.CameraController)
    end)
    if ok and type(mod) == "table" then CameraControllerModule = mod end
    return CameraControllerModule
end

local function GetLocalEquippedItem()
    local fighter = FighterControllerSafe and FighterControllerSafe.LocalFighter or nil
    return fighter and fighter.EquippedItem or nil
end

local function GetLocalGunInfo()
    local item = GetLocalEquippedItem()
    if not item then return nil, nil, nil end
    local name = item.Name
    local ammo = nil
    pcall(function() ammo = item:Get("Ammo") end)
    if type(ammo) ~= "number" then ammo = nil end
    local maxAmmo = nil
    pcall(function() maxAmmo = item.Info.MaxAmmo end)
    if type(maxAmmo) ~= "number" then maxAmmo = nil end
    return name, ammo, maxAmmo
end

local function GetGunTipWorld()
    local item = GetLocalEquippedItem()
    if item then
        local vm = rawget(item, "ViewModel")
        if vm and type(vm.GetMuzzlePosition) == "function" then
            local ok, pos = pcall(function() return vm:GetMuzzlePosition() end)
            if ok and typeof(pos) == "Vector3" then return pos end
        end
    end
    local vp = workspace:FindFirstChild("ViewModels")
    local fp = vp and vp:FindFirstChild("FirstPerson")
    if fp then
        local muz = fp:FindFirstChild("Muzzle", true)
        if muz then return muz.WorldPosition end
    end
    local cam = workspace.CurrentCamera
    return cam.CFrame.Position + cam.CFrame.LookVector * 3
end

-- // 7. Viewmodel chams reconcile (gun + arms, UNCHANGED)
local ChamsCache = {}
local function ReconcileChams()
    local vp = workspace:FindFirstChild("ViewModels")
    local fp = vp and vp:FindFirstChild("FirstPerson")
    local seen = {}
    if fp then
        local targets = {}
        for _, model in ipairs(fp:GetChildren()) do
            if model:IsA("Model") then
                local isGun = model:FindFirstChild("ItemVisual", true) ~= nil or model:FindFirstChild("Muzzle", true) ~= nil
                if isGun then
                    targets[#targets + 1] = { model = model, kind = "Gun" }
                    for _, sub in ipairs(model:GetChildren()) do
                        if sub:IsA("Model") and sub.Name:match("Arm") then
                            targets[#targets + 1] = { model = sub, kind = "Arm" }
                        end
                    end
                elseif model.Name:match("Arm") or model:FindFirstChild("LeftArm", true) or model:FindFirstChild("RightArm", true) then
                    targets[#targets + 1] = { model = model, kind = "Arm" }
                end
            end
        end
        for _, entry in ipairs(targets) do
            local model, kind = entry.model, entry.kind
            seen[model] = true
            local wantOn = (kind == "Gun" and Toggles.GunChams.Value) or (kind == "Arm" and Toggles.ArmChams.Value)
            local cached = ChamsCache[model]
            if wantOn then
                if not cached then
                    local h = Instance.new("Highlight")
                    h.Adornee = model
                    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    h.Parent = model
                    cached = { h = h }
                    ChamsCache[model] = cached
                end
                cached.h.FillColor = (kind == "Gun" and Options.GunChamsFill.Value or Options.ArmChamsFill.Value)
                cached.h.OutlineColor = (kind == "Gun" and Options.GunChamsOutline.Value or Options.ArmChamsOutline.Value)
                cached.h.FillTransparency = Options.ChamsFillTransparency.Value
                cached.h.OutlineTransparency = 0
                cached.h.Enabled = true
            elseif cached then
                cached.h.Enabled = false
            end
        end
    end
    for model, cached in pairs(ChamsCache) do
        if not seen[model] or not model.Parent then
            pcall(function() cached.h:Destroy() end)
            ChamsCache[model] = nil
        end
    end
end

