local function lockPlayer()
    if RageEnabled then
        if rageTargetPart and rageTargetPart.Parent then
            local p = Players:GetPlayerFromCharacter(rageTargetPart.Parent)
            if p and p ~= LocalPlayer then return p end
        end
        local p, _ = nearestEnemy(); return p
    end
    local center = screenCenter()
    local radius
    if AimEnabled then radius = AimFOV
    elseif SilentEnabled then radius = getgenv().Config.FOVRadius
    else radius = 260 end
    local best, bd = nil, radius
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer or not plr.Character then continue end
        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local head = plr.Character:FindFirstChild("Head") or plr.Character:FindFirstChild("HumanoidRootPart")
        if not head then continue end
        local sp, on = worldToScreen(head.Position); if not on then continue end
        local d = (sp - center).Magnitude
