        local queryUrl = "https://lrclib.net/api/get?artist_name=" .. HttpService:UrlEncode(aName) .. "&track_name=" .. HttpService:UrlEncode(sName)
        local success, res = pcall(function()
            return request({ Url = queryUrl, Method = "GET" })
        end)
        
        local lrcLines = {}
        if success && res && res.StatusCode == 200 then
            local data = HttpService:JSONDecode(res.Body)
            if data && data.syncedLyrics then
                lrcLines = parseLRC(data.syncedLyrics)
            end
        end
        
        local safeName = sanitizeFileName(aName .. "_" .. sName) .. ".mp3"
        local filePath = "songs/" .. safeName
        
        if not isfile(filePath) then
            local dlSuccess, dlRes = pcall(function()
                return request({ Url = url, Method = "GET" })
            end)
            if dlSuccess && dlRes && dlRes.StatusCode == 200 then
                writefile(filePath, dlRes.Body)
            end
        end
        
        table.insert(playlist, {
            songName = sName,
            artistName = aName,
            filePath = filePath,
            lyrics = lrcLines
        })
        
        refreshLibraryUI()
        loadBtn.Text = "Add & Play"
        playTrackAtIndex(#playlist)
    end)
end)

-- Playback Controls Hookups
local function togglePlay()
    if currentSoundInstance then
        if currentSoundInstance.IsPlaying then
            currentSoundInstance:Pause()
            isSyncing = false
            playBtn.Text = "▶"
            miniPlay.Text = "▶"
        else
            currentSoundInstance:Resume()
            isSyncing = true
            playBtn.Text = "⏸"
            miniPlay.Text = "⏸"
        end
    end
end

prevBtn.MouseButton1Click:Connect(function() playTrackAtIndex(currentIndex - 1) end)
nextBtn.MouseButton1Click:Connect(function() playTrackAtIndex(currentIndex + 1) end)
playBtn.MouseButton1Click:Connect(togglePlay)

miniPrev.MouseButton1Click:Connect(function() playTrackAtIndex(currentIndex - 1) end)
miniNext.MouseButton1Click:Connect(function() playTrackAtIndex(currentIndex + 1) end)
miniPlay.MouseButton1Click:Connect(togglePlay)
