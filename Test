    if not Toggles.IgnoreFOV.Value then maxDist = 500 end

    -- Aimbot
    if Toggles.AimEnabled.Value then
        local target = ResolveAimTarget(cam, maxDist)
        if target then
            if Options.AimMode.Value == "Camera" then
                local speed = Options.AimSpeed.Value / 100
                local targetCF = CFrame.lookAt(cam.CFrame.Position, target.part_pos)
                cam.CFrame = cam.CFrame:Lerp(targetCF, speed)
            end
            -- Silent mode hooks raycast elsewhere
            getgenv()._AimbotTarget = target
        end
    end

    -- Triggerbot
    if Toggles.Triggerbot.Value then
        local target = ResolveTriggerTarget(cam)
        if target then
            local now = tick()
            if TrigTargetLock ~= target.player then
                TrigTargetLock = target.player
                TrigAcquiredAt = now
            end
            local react = Options.TrigReact.Value
            if (now - TrigAcquiredAt) >= react then
                local ok = pcall(function()
                    local vim = Instance.new("VirtualInputManager")
                    local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
                    vim:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 1)
                    vim:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 1)
                end)
            end
        else
            TrigTargetLock = nil
            TrigAcquiredAt = 0
        end
    end

    -- Flickbot
    if Toggles.Flickbot.Value then
        local target = ResolveAimTarget(cam, maxDist)
        if target then
            local speed = Options.AimSpeed.Value / 100
            local targetCF = CFrame.lookAt(cam.CFrame.Position, target.part_pos)
            cam.CFrame = cam.CFrame:Lerp(targetCF, math.min(speed * 2, 1))
        end
    end
end)

-- Silent aim hook
pcall(function()
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local mods = ReplicatedStorage:FindFirstChild("Modules")
    local utilMod = mods and mods:FindFirstChild("Utility")
    if utilMod then
        local ok, util = pcall(require, utilMod)
        if ok and type(util) == "table" and type(util.Raycast) == "function" then
            local origRaycast = util.Raycast
            util.Raycast = function(self, origin, direction, ...)
                local target = getgenv()._AimbotTarget
                if target and Toggles.AimEnabled.Value and Options.AimMode.Value == "Silent" then
                    local dir = (target.part_pos - origin)
                    if dir.Magnitude > 0 then
                        return origRaycast(self, origin, dir.Unit, ...)
                    end
                end
                return origRaycast(self, origin, direction, ...)
            end
        end
    end
end)

-- // 8. Chams
local ChamsObjects = {}
local function ApplyCham(char, fill, outline)
    local existing = ChamsObjects[char]
    if existing then pcall(function() existing:Destroy() end) end
    local hl = Instance.new("Highlight")
    hl.FillColor = fill
    hl.OutlineColor = outline
    hl.FillTransparency = 0.4
    hl.OutlineTransparency = 0
    hl.Adornee = char
    hl.Parent = char
    ChamsObjects[char] = hl
end
local function RemoveCham(char)
    local e = ChamsObjects[char]
    if e then pcall(function() e:Destroy() end); ChamsObjects[char] = nil end
end
RunService.Heartbeat:Connect(function()
    local charChams = Toggles.CharChams.Value
    local armChams = Toggles.ArmChams.Value
    for player, hl in pairs(ChamsObjects) do
        local char = player.Character
        if not char or not char.Parent then
            pcall(function() hl:Destroy() end); ChamsObjects[player] = nil
        end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LP then continue end
        if not IsEnemyTeam(player) and not Toggles.ESPTeam.Value then continue end
        local char = player.Character
        if not char then continue end
        if charChams or armChams then
            local fill = charChams and Options.CharChamsFill.Value or Options.ArmChamsFill.Value
            local outline = charChams and Options.CharChamsOutline.Value or Options.ArmChamsOutline.Value
            if not ChamsObjects[player] then
                ApplyCham(char, fill, outline)
            else
                ChamsObjects[player].FillColor = fill
                ChamsObjects[player].OutlineColor = outline
            end
        else
            RemoveCham(player)
        end
    end
end)

