local CrosshairOutlines = {
    Top = Drawing.new("Line"), Bottom = Drawing.new("Line"),
    Left = Drawing.new("Line"), Right = Drawing.new("Line"),
}
local CrosshairLines = {
    Top = Drawing.new("Line"), Bottom = Drawing.new("Line"),
    Left = Drawing.new("Line"), Right = Drawing.new("Line"),
}
local crosshairAngle = 0

RunService.RenderStepped:Connect(function(dt)
    local enabled = Toggles.CrosshairEnabled and Toggles.CrosshairEnabled.Value
    for _, line in pairs(CrosshairLines) do line.Visible = enabled end
    for _, line in pairs(CrosshairOutlines) do line.Visible = enabled and getgenv().Config.CrosshairOutline end
    if not enabled then return end

    local cam = workspace.CurrentCamera
    if not cam then return end
    
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local followMode = getgenv().Config.CrosshairFollow
    if followMode == "Follow Target" and SmoothTargetScreen ~= Vector2.new(0,0) then
        center = SmoothTargetScreen
    elseif followMode == "Follow Gun Tip" and SmoothGunTipScreen ~= Vector2.new(0,0) then
        center = SmoothGunTipScreen
    end

    local size = Options.CrosshairSize and Options.CrosshairSize.Value or 10
    if getgenv().Config.CrosshairBreathing then
        size = size * (1 + math.sin(tick() * (getgenv().Config.CrosshairBreathingSpeed or 2)) * 0.3)
    end
    local gap = Options.CrosshairGap and Options.CrosshairGap.Value or 4
    local thickness = Options.CrosshairThickness and Options.CrosshairThickness.Value or 2
    local outThick = getgenv().Config.CrosshairOutlineThickness or 4
    local outColor = getgenv().Config.CrosshairOutlineColor or Color3.new(0,0,0)
    
    if Toggles.CrosshairSpin and Toggles.CrosshairSpin.Value then
        local speed = Options.CrosshairSpinSpeed and Options.CrosshairSpinSpeed.Value or 0
        crosshairAngle = crosshairAngle + speed * (dt or 0.016)
    else
        crosshairAngle = 0
    end

    local cosA = math.cos(crosshairAngle)
    local sinA = math.sin(crosshairAngle)
    local function rotate(vec)
        return Vector2.new(vec.X * cosA - vec.Y * sinA, vec.X * sinA + vec.Y * cosA)
    end

    local points = {
        Top = { start = rotate(Vector2.new(0, -gap)), ends = rotate(Vector2.new(0, -(gap + size))), color = getgenv().Config.CrosshairTopColor },
        Bottom = { start = rotate(Vector2.new(0, gap)), ends = rotate(Vector2.new(0, gap + size)), color = getgenv().Config.CrosshairBottomColor },
        Left = { start = rotate(Vector2.new(-gap, 0)), ends = rotate(Vector2.new(-(gap + size), 0)), color = getgenv().Config.CrosshairLeftColor },
        Right = { start = rotate(Vector2.new(gap, 0)), ends = rotate(Vector2.new(gap + size, 0)), color = getgenv().Config.CrosshairRightColor },
    }

    for name, p in pairs(points) do
        if getgenv().Config.CrosshairOutline then
            CrosshairOutlines[name].From = center + p.start
            CrosshairOutlines[name].To = center + p.ends
            CrosshairOutlines[name].Color = outColor
            CrosshairOutlines[name].Thickness = outThick
        end
        CrosshairLines[name].From = center + p.start
        CrosshairLines[name].To = center + p.ends
        CrosshairLines[name].Color = p.color
        CrosshairLines[name].Thickness = thickness
    end
end)

