-- // 7. Viewmodel chams reconcile (+ wireframe: 0.75 transparency + thin white outline)
local ChamsCache = {}
local WireCache = {}
local function ReconcileChams()
local vp = workspace:FindFirstChild("ViewModels")
local fp = vp and vp:FindFirstChild("FirstPerson")
local seen = {}
local targets = {}
if fp then
for _, model in ipairs(fp:GetChildren()) do
if model:IsA("Model") then
local isGun = model:FindFirstChild("ItemVisual", true) ~= nil or model:FindFirstChild("Muzzle", true) ~= nil
if isGun then
targets[#targets + 1] = { model = model, kind = "Gun" }
for _, sub in ipairs(model:GetChildren()) do
if sub:IsA("Model") and sub.Name:match("Arm") then
targets[#targets + 1] = { model = sub, kind = "Arm" }
end
end
elseif model.Name:match("Arm") or model:FindFirstChild("LeftArm", true) or model:FindFirstChild("RightArm", true) then
targets[#targets + 1] = { model = model, kind = "Arm" }
end
end
end
end
for _, entry in ipairs(targets) do
local model, kind = entry.model, entry.kind
seen[model] = true
local wantOn = (kind == "Gun" and Toggles.GunChams.Value) or (kind == "Arm" and Toggles.ArmChams.Value)
local wantWire = Toggles.ChamsWireframe and Toggles.ChamsWireframe.Value
local cached = ChamsCache[model]
if wantOn or wantWire then
if not cached then
local h = Instance.new("Highlight")
h.Adornee = model
h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
h.Parent = model
cached = { h = h }
ChamsCache[model] = cached
end
if wantWire then
cached.h.FillColor = Color3.new(1, 1, 1)
cached.h.FillTransparency = 1
cached.h.OutlineColor = Color3.new(1, 1, 1)
cached.h.OutlineTransparency = 0
for _, part in ipairs(entry.model:GetDescendants()) do
if part:IsA("BasePart") then
if WireCache[part] == nil then
WireCache[part] = { Transparency = part.Transparency, Material = part.Material }
end
part.Transparency = 0.75
end
end
else
cached.h.FillColor = (kind == "Gun" and Options.GunChamsFill.Value or Options.ArmChamsFill.Value)
cached.h.OutlineColor = (kind == "Gun" and Options.GunChamsOutline.Value or Options.ArmChamsOutline.Value)
cached.h.FillTransparency = Options.ChamsFillTransparency.Value
cached.h.OutlineTransparency = 0
end
cached.h.Enabled = true
elseif cached then
cached.h.Enabled = false
end
end
if not (Toggles.ChamsWireframe and Toggles.ChamsWireframe.Value) then
for part, original in pairs(WireCache) do
pcall(function()
part.Transparency = original.Transparency
part.Material = original.Material
end)
WireCache[part] = nil
end
end
for model, cached in pairs(ChamsCache) do
if not seen[model] or not model.Parent then
pcall(function() cached.h:Destroy() end)
ChamsCache[model] = nil
end
end
end
