            if n:find(cand, 1, true) then return true end
        end
        return false
    end
    local function findShootRemote()
        if SHOOT_STATE.remote then return SHOOT_STATE.remote end
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if not remotes then return nil end
        for _, r in ipairs(remotes:GetDescendants()) do
            if (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) and matchesShootName(r.Name:lower()) then
                SHOOT_STATE.remote = r
                return r
            end
        end
        return nil
    end
    SHOOT_STATE.getTarget = function()
        if RageEnabled and rageTargetPart and rageTargetPart.Parent then return rageTargetPart end
        if SilentEnabled then return silentTarget() end
        return nil
    end
    task.spawn(function()
        task.wait(3)
        findShootRemote()
        if SHOOT_STATE.remote then
            pcall(function() Library:Notify("Shoot remote locked: " .. SHOOT_STATE.remote.Name, 3) end)
        else
            pcall(function() Library:Notify("Shoot remote not found — scanning on respawn", 3) end)
            LocalPlayer.CharacterAdded:Connect(function()
                task.wait(2)
                if not SHOOT_STATE.remote and findShootRemote() then
                    pcall(function() Library:Notify("Shoot remote locked: " .. SHOOT_STATE.remote.Name, 3) end)
                end
            end)
        end
    end)
    pcall(function()
        ReplicatedStorage.DescendantAdded:Connect(function(obj)
            if not SHOOT_STATE.remote and (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) then
                task.delay(1, findShootRemote)
            end
        end)
    end)
end

--[[ EXTRA FEATURES — Gun Chams, No Shoot Anim, Ragebot curves, Void Hide, Bullet Tracers, In Round Detector ]]
do
    local GunChams = false
    local ArmChams = false
    local NoShootAnim = false
    local VoidHide = false
    local BulletTracers = false
    local InRoundDetector = false
    local GunChamColor = Color3.fromRGB(0, 255, 255)
    local ArmChamColor = Color3.fromRGB(255, 0, 255)
    local TracerColor = Color3.fromRGB(0, 255, 255)
    local RageCurve = "Linear"
    local shotT = 0
    local drawnT = -1
    local origGunProps = {}
    local origArmProps = {}

    local function applyGunChams()
        pcall(function()
            local vm = workspace:FindFirstChild("ViewModels")
            if not vm then return end
            local fp = vm:FindFirstChild("FirstPerson")
            if not fp then return end
            for _, model in ipairs(fp:GetChildren()) do
                if model:IsA("Model") then
                    local itemVisual = model:FindFirstChild("ItemVisual")
                    if itemVisual then
                        for _, part in ipairs(itemVisual:GetDescendants()) do
                            if part:IsA("BasePart") then
                                if not origGunProps[part] then
                                    origGunProps[part] = { Material = part.Material, Color = part.Color, Transparency = part.Transparency }
                                end
                                if GunChams then
                                    part.Material = Enum.Material.Neon
                                    part.Color = GunChamColor
                                    part.Transparency = 0.3
                                else
                                    local orig = origGunProps[part]
                                    if orig then
                                        part.Material = orig.Material
                                        part.Color = orig.Color
                                        part.Transparency = orig.Transparency
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)
    end

    local function applyArmChams()
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and (part.Name:lower():find("arm") or part.Name:lower():find("hand")) then
                    if not origArmProps[part] then
                        origArmProps[part] = { Material = part.Material, Color = part.Color, Transparency = part.Transparency }
                    end
                    if ArmChams then
                        part.Material = Enum.Material.Neon
                        part.Color = ArmChamColor
                        part.Transparency = 0.5
                    else
                        local orig = origArmProps[part]
                        if orig then
                            part.Material = orig.Material
                            part.Color = orig.Color
                            part.Transparency = orig.Transparency
                        end
                    end
                end
            end
        end)
    end

    local function killShootAnims()
        pcall(function()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Animator then
                for _, tr in ipairs(hum.Animator:GetPlayingTracks()) do
                    local a = tr.Animation
                    if a then
                        local n = (a.Name or ""):lower()
                        if n:find("shoot") or n:find("fire") or n:find("shot") then tr:Stop() end
                    end
                end
            end
            for _, d in ipairs(Camera:GetDescendants()) do
                if d:IsA("Animator") then
                    for _, tr in ipairs(d:GetPlayingTracks()) do
                        local a = tr.Animation
                        if a then
                            local n = (a.Name or ""):lower()
                            if n:find("shoot") or n:find("fire") or n:find("shot") then tr:Stop() end
                        end
                    end
                end
            end
        end)
    end

    local marked = false
    local function installShotMarker()
        if marked then return true end
        local ok2 = pcall(function()
            GunModule = require(LocalPlayer.PlayerScripts.Modules.ItemTypes.Gun)
        end)
        if not ok2 or not GunModule or not GunModule.StartShooting then return false end
        local orig = GunModule.StartShooting
        GunModule.StartShooting = function(self, ...)
            shotT = os.clock()
            local r = { orig(self, ...) }
            if NoShootAnim then killShootAnims() end
            return unpack(r)
        end
        marked = true
        return true
    end

    local function spawnTracer(from, to)
        local l = Drawing.new("Line")
        l.From = from
        l.To = to
        l.Thickness = 2
        l.Color = TracerColor
        l.Transparency = 0
        l.Visible = true
        task.spawn(function()
            for i = 1, 5 do
                task.wait(0.04)
                l.Transparency = i / 5
            end
            l:Remove()
        end)
    end

    RunService.RenderStepped:Connect(function(dt)
        if GunChams or ArmChams then
            applyGunChams()
            applyArmChams()
        end
        if BulletTracers and shotT ~= drawnT and os.clock() - shotT < 0.05 then
            drawnT = shotT
            local from = getGunTip()
            local to = nil
            if RageEnabled and rageTargetPart and rageTargetPart.Parent then
                to = rageTargetPart.Position
            elseif SilentEnabled then
                local p = silentTarget()
                if p then to = p.Position end
            end
            if not to then
                local o = Camera.CFrame.Position
                local d = Camera.CFrame.LookVector
                local hit = workspace:Raycast(o, d * 1000)
                to = hit and hit.Position or (o + d * 1000)
            end
            if from and to then spawnTracer(from, to) end
        end
        if VoidHide then
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root and root.Position.Y < -50 then
                    for _, p in ipairs(char:GetDescendants()) do
                        if p:IsA("BasePart") and not p:GetAttribute("veilVoid") then
                            p:SetAttribute("veilVoid", p.Transparency)
                            p.Transparency = 1
                        end
                    end
                else
                    for _, p in ipairs(char:GetDescendants()) do
                        if p:IsA("BasePart") and p:GetAttribute("veilVoid") then
                            p.Transparency = p:GetAttribute("veilVoid")
                            p:SetAttribute("veilVoid", nil)
                        end
                    end
                end
            end)
        end
    end)

    RunService.Heartbeat:Connect(function()
        if InRoundDetector then
            pcall(function()
                local inRound = false
                local char = LocalPlayer.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        inRound = true
                    end
                end
                if inRound then
                    setStatus("(Round Active)")
                elseif not RageEnabled then
                    setStatus("(Waiting)")
                end
            end)
        end
    end)

    local function restoreAll()
        for part, orig in pairs(origGunProps) do
            pcall(function()
                part.Material = orig.Material
                part.Color = orig.Color
                part.Transparency = orig.Transparency
            end)
        end
        for part, orig in pairs(origArmProps) do
            pcall(function()
                part.Material = orig.Material
                part.Color = orig.Color
                part.Transparency = orig.Transparency
            end)
        end
        origGunProps = {}
        origArmProps = {}
    end

    tab("Extra", function()
        local G = Tabs.Extra:AddLeftGroupbox("Combat Extras")
        G:AddToggle("GunChams", {
            Text = "Gun Chams", Default = false,
            Tooltip = "Neon material on viewmodel gun parts",
            Callback = function(v) GunChams = v; if not v then restoreAll() end end,
        })
        G:AddToggle("ArmChams", {
            Text = "Arm Chams", Default = false,
            Tooltip = "Neon material on character arms",
            Callback = function(v) ArmChams = v; if not v then restoreAll() end end,
        })
        G:AddToggle("NoShootAnim", {
            Text = "No Shoot Animation", Default = false,
            Tooltip = "Kills shoot anim tracks after every shot",
            Callback = function(v)
                NoShootAnim = v
                if v and not installShotMarker() then
                    Library:Notify("No shoot anim: Gun module not ready (respawn & retry)", 3)
                end
            end,
        })
        G:AddToggle("VoidHide", {
            Text = "Void Hide", Default = false,
            Tooltip = "Auto-hide character when falling into void (Y < -50)",
            Callback = function(v) VoidHide = v end,
        })
        G:AddToggle("BulletTracers", {
            Text = "Bullet Tracers", Default = false,
            Tooltip = "Fading line from muzzle to each shot",
            Callback = function(v)
                BulletTracers = v
                if v and not installShotMarker() then
                    Library:Notify("Tracers: Gun module not ready (respawn & retry)", 3)
                end
            end,
        })
        G:AddToggle("InRoundDetector", {
            Text = "In Round Detector", Default = false,
            Tooltip = "Shows '(Round Active)' in status when alive",
            Callback = function(v) InRoundDetector = v end,
        })
        G:AddLabel("Gun Cham Color"):AddColorPicker("GunChamCol", {
            Title = "Gun Cham", Default = Color3.fromRGB(0, 255, 255),
            Callback = function(v) GunChamColor = v end,
        })
        G:AddLabel("Arm Cham Color"):AddColorPicker("ArmChamCol", {
            Title = "Arm Cham", Default = Color3.fromRGB(255, 0, 255),
            Callback = function(v) ArmChamColor = v end,
        })
        G:AddLabel("Tracer Color"):AddColorPicker("TracerCol", {
            Title = "Tracer", Default = Color3.fromRGB(0, 255, 255),
            Callback = function(v) TracerColor = v end,
        })
        G:AddDropdown("RageCurve", {
            Text = "Rage Aim Curve", Default = "Linear",
            Values = {"Linear", "Expo", "EaseIn", "EaseOut", "Instant"}, Multi = false,
            Tooltip = "Smoothing curve for ragebot aim",
            Callback = function(v) RageCurve = v end,
        })
    end)
end

