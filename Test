local function ensureRaycastHook()
    if RayHooked then return true end
    if not UtilityModule or not OriginalRaycast then
        pcall(function()
            UtilityModule = require(ReplicatedStorage.Modules.Utility)
            OriginalRaycast = UtilityModule.Raycast
        end)
    end
    if not UtilityModule or not OriginalRaycast then return false end
    UtilityModule.Raycast = function(self, origin, dir, maxDist, ...)
        if RageEnabled and rageTargetPart and rageTargetPart.Parent then
            local tp = rageTargetPart.Position
            local u = (tp - origin).Unit
            local dist = (tp - origin).Magnitude
            if type(maxDist) == "number" and dist > maxDist then dist = maxDist; tp = origin + u * maxDist end
            return { Position = tp, Distance = dist, Instance = rageTargetPart, Material = rageTargetPart.Material, Normal = -u }
        end
        if SilentEnabled then
            if type(maxDist) ~= "number" or maxDist < 100 then
                return OriginalRaycast(self, origin, dir, maxDist, ...)
            end
            local tgt = silentTarget()
            if not tgt then return OriginalRaycast(self, origin, dir, maxDist, ...) end
            local tp = tgt.Position; local u = (tp - origin).Unit
            local dist = (tp - origin).Magnitude
            if dist > maxDist then dist = maxDist; tp = origin + u * maxDist end
            return { Position = tp, Distance = dist, Instance = tgt, Material = tgt.Material, Normal = -u }
        end
        return OriginalRaycast(self, origin, dir, maxDist, ...)
    end
    RayHooked = true
    return true
end
