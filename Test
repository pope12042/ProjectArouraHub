local function splitStatus(s)
    local mid = math.floor(#s / 2)
    local pivot = nil
    for off = 0, mid do
        if mid - off >= 1 and s:sub(mid - off, mid - off) == " " then pivot = mid - off; break end
        if mid + off <= #s and s:sub(mid + off, mid + off) == " " then pivot = mid + off; break end
    end
    if not pivot then pivot = mid end
    return s:sub(1, pivot), s:sub(pivot + 1)
end
