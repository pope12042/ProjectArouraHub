-- FIXED scale: project head+feet, derive height from screen-space.
local function GetPlayerScreenBox(char, cam)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head") or char:FindFirstChild("HitboxHead")
    if not hrp then return nil end
    local headPos = (head and head.Position) or (hrp.Position + Vector3.new(0,2.5,0))
    local feetPos = hrp.Position - Vector3.new(0,3,0)
    local headS, hOn = cam:WorldToViewportPoint(headPos)
    local feetS, fOn = cam:WorldToViewportPoint(feetPos)
    if not hOn and not fOn then return nil end
    local topY = math.min(headS.Y, feetS.Y)
    local botY = math.max(headS.Y, feetS.Y)
    local height = botY - topY
    local width = height * 0.5
    return {
        X = headS.X - width/2, Y = topY, W = width, H = height,
        CX = headS.X, dist = (cam.CFrame.Position - hrp.Position).Magnitude
    }
end

local function UpdateESP()
    local cam = workspace.CurrentCamera
    local enabled = Toggles.ESPEnabled.Value
    local teamCheck = Toggles.ESPTeam.Value
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    for player, e in pairs(ESPObjects) do
        local char = player.Character
        if not enabled or not char or not ShouldShow(player, teamCheck) then
            HideESP(e); goto continue
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp or not hum or hum.Health <= 0 then HideESP(e); goto continue end
        local box = GetPlayerScreenBox(char, cam)
        if not box or box.H <= 0 then HideESP(e); goto continue end
        local visible = true -- visibility heuristic
        local color = visible and Options.ESPVisible.Value or Options.ESPHidden.Value
        -- box
        e.box.Visible = Toggles.ESPBox.Value
        e.box.Position = Vector2.new(box.X, box.Y)
        e.box.Size = Vector2.new(box.W, box.H)
        e.box.Color = color
        e.box.Thickness = 1.5
        e.box.Filled = false
        -- name
        e.name.Visible = Toggles.ESPName.Value
        e.name.Text = player.DisplayName
        e.name.Position = Vector2.new(box.CX, box.Y - 18)
        e.name.Center = true; e.name.Outline = true
        e.name.Size = 13; e.name.Color = color
        -- distance
        e.dist.Visible = Toggles.ESPDISTANCE.Value
        e.dist.Text = string.format("%dm", math.floor(box.dist))
        e.dist.Position = Vector2.new(box.CX, box.Y + box.H + 2)
        e.dist.Center = true; e.dist.Outline = true
        e.dist.Size = 12; e.dist.Color = color
        -- health
        e.hpBar.Visible = Toggles.ESPHealth.Value
        local hp = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        e.hpBar.Position = Vector2.new(box.X - 5, box.Y + box.H * (1-hp))
        e.hpBar.Size = Vector2.new(3, box.H * hp)
        e.hpBar.Color = Color3.fromRGB(255*(1-hp), 255*hp, 0)
        e.hpBar.Filled = true
        -- tracer
        e.tracer.Visible = Toggles.Tracers.Value and (not Toggles.TracerTeam.Value or IsEnemyTeam(player))
        e.tracer.From = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y)
        e.tracer.To = Vector2.new(box.CX, box.Y + box.H)
        e.tracer.Color = visible and Options.TracerVisible.Value or Options.TracerHidden.Value
        e.tracer.Thickness = 1.5
        ::continue::
    end
end

