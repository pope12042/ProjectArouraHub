local CurrentSkyboxName = nil
local function ApplySkybox(name)
    local sky = Lighting:FindFirstChildOfClass("Sky")
    if not sky then sky = Instance.new("Sky"); sky.Parent = Lighting end
    if name == "None" or not SkyPresets[name] then
        sky.SkyboxBk=""; sky.SkyboxDn=""; sky.SkyboxFt=""; sky.SkyboxLf=""; sky.SkyboxRt=""; sky.SkyboxUp=""
        return
    end
    local p = SkyPresets[name]
    sky.SkyboxBk = p.SkyboxBk or ""
    sky.SkyboxDn = p.SkyboxDn or ""
    sky.SkyboxFt = p.SkyboxFt or ""
    sky.SkyboxLf = p.SkyboxLf or ""
    sky.SkyboxRt = p.SkyboxRt or ""
    sky.SkyboxUp = p.SkyboxUp or ""
    if p.StarCount then sky.StarCount = p.StarCount end
    if p.SunAngularSize then sky.SunAngularSize = p.SunAngularSize end
    if p.MoonAngularSize then sky.MoonAngularSize = p.MoonAngularSize end
end

