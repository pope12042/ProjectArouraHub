local function closestTarget()
    local center = screenCenter(); local best, bestD = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer or not plr.Character then continue end
        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local head = plr.Character:FindFirstChild("Head")
        if not head then continue end
        local sp, on = worldToScreen(head.Position); if not on then continue end
        local d = (sp - center).Magnitude
        if d < bestD then bestD = d; best = plr end
    end
    return best
end

--[[ AIMBOT with gradient FOV + follow ]]
pcall(function()
    local GRAD_SEGS = 24
    local gradLines = {}
    for i = 1, GRAD_SEGS do
        local l = Drawing.new("Line"); l.Visible = false; l.Thickness = 2
        gradLines[i] = l
    end
    local gradOutline = Drawing.new("Circle"); gradOutline.Filled = false; gradOutline.Visible = false; gradOutline.Thickness = 1
    local gradFill = Drawing.new("Circle"); gradFill.Filled = true; gradFill.Visible = false
    local spinAngle = 0
    local normalCircle = Drawing.new("Circle"); normalCircle.Filled = false; normalCircle.Visible = false; normalCircle.Thickness = 1
    local normalFill = Drawing.new("Circle"); normalFill.Filled = true; normalFill.Visible = false

    local function nearestPlayerScreen()
        local cam = workspace.CurrentCamera
        local center = screenCenter(); local best, bestD = nil, math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer or not plr.Character then continue end
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            local head = plr.Character:FindFirstChild("Head")
            if not head then continue end
            local sp, on = cam:WorldToViewportPoint(head.Position)
            if not on then continue end
            local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
            if d < bestD then bestD = d; best = Vector2.new(sp.X, sp.Y) end
        end
        return best
    end

    RunService.RenderStepped:Connect(function(dt)
        Camera = workspace.CurrentCamera
        if not AimbotEnabled then
            for i = 1, GRAD_SEGS do gradLines[i].Visible = false end
            gradOutline.Visible = false; gradFill.Visible = false
            normalCircle.Visible = false; normalFill.Visible = false
            return
        end
        local cam = workspace.CurrentCamera
        local radius = AimbotFOV
        local follow = Options.aimbot_fov_follow and Options.aimbot_fov_follow.Value or {}
        local center = screenCenter()
        if follow["follow player"] then
            local np = nearestPlayerScreen()
            if np then center = np end
        elseif follow["follow gun tip"] then
            local tip = getGunTip()
            if tip then
                local sp, on = cam:WorldToViewportPoint(tip)
                if on then center = Vector2.new(sp.X, sp.Y) end
            end
        end
        local gradient = Toggles.aimbot_fov_gradient and Toggles.aimbot_fov_gradient.Value
        local spinSpeed = Options.aimbot_grad_spin and Options.aimbot_grad_spin.Value or 0
        spinAngle = spinAngle + math.rad(spinSpeed) * (dt or 0.016)
        local c1 = Options.aimbot_grad_color1 and Options.aimbot_grad_color1.Value or Color3.fromRGB(0, 255, 120)
        local c2 = Options.aimbot_grad_color2 and Options.aimbot_grad_color2.Value or Color3.fromRGB(120, 0, 255)
        if gradient then
            normalCircle.Visible = false; normalFill.Visible = false
            gradFill.Visible = true; gradFill.Position = center; gradFill.Radius = radius
            gradFill.Color = c1; gradFill.Transparency = 0.7
            gradOutline.Visible = true; gradOutline.Position = center; gradOutline.Radius = radius; gradOutline.Color = c1
            for i = 1, GRAD_SEGS do
                local a0 = spinAngle + ((i - 1) / GRAD_SEGS) * math.pi * 2
                local t = (i - 1) / GRAD_SEGS
                local col = c1:Lerp(c2, t)
                local l = gradLines[i]
                l.From = center
                l.To = center + Vector2.new(math.cos(a0), math.sin(a0)) * radius
                l.Color = col; l.Visible = true
            end
        else
            for i = 1, GRAD_SEGS do gradLines[i].Visible = false end
            gradOutline.Visible = false; gradFill.Visible = false
            normalCircle.Visible = true; normalCircle.Position = center; normalCircle.Radius = radius; normalCircle.Color = c1
            normalFill.Visible = Toggles.aimbot_fov_fill and Toggles.aimbot_fov_fill.Value or false
            normalFill.Position = center; normalFill.Radius = radius; normalFill.Color = c1; normalFill.Transparency = 0.7
        end
        -- aimbot aim
        local best, bestDist = nil, AimbotFOV
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer or not plr.Character then continue end
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            local ally = plr.Character:FindFirstChild("_is_ally")
            if ally and ally.Value then continue end
            local part = nil
            if AimbotLock == "Head" then part = plr.Character:FindFirstChild("Head") or plr.Character:FindFirstChild("HitboxHead")
            elseif AimbotLock == "Torso" then part = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("UpperTorso")
            else
                local parts = {}
                for _, p in ipairs(plr.Character:GetDescendants()) do if p:IsA("BasePart") then table.insert(parts, p) end end
                if #parts > 0 then part = parts[math.random(1, #parts)] end
            end
            if not part then continue end
            local sp, on = cam:WorldToViewportPoint(part.Position)
            if not on then continue end
            local d = (Vector2.new(sp.X, sp.Y) - screenCenter()).Magnitude
            if d < bestDist then bestDist = d; best = part end
        end
        if best then
            local desired = CFrame.lookAt(cam.CFrame.Position, best.Position)
            cam.CFrame = cam.CFrame:Lerp(desired, AimbotSens)
        end
    end)
end)

