local function posInButton(pos, btn)
    if not btn then return false end
    local ap = btn.AbsolutePosition; local as = btn.AbsoluteSize
    return pos.X >= ap.X and pos.X <= ap.X + as.X and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y
end
local function isFireTouch(pos)
    if fireButton and posInButton(pos, fireButton) then return true end
    if not fireButtonSearched then return false end
    if not fireButton then
        local vp = Camera.ViewportSize
        return pos.X > vp.X * 0.62 and pos.Y > vp.Y * 0.5
    end
    return false
end
local function isAimTouch(pos)
    if aimButton and posInButton(pos, aimButton) then return true end
    return false
end
local function isFiring()
    if mouse1Held then return true end
    for _, pos in pairs(activeTouches) do if isFireTouch(pos) then return true end end
    return false
end
local function isAiming()
    local m = AimTrigger
    if m == "Always" then return true end
    local rmb = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    local ab = false
    for _ in pairs(activeAimTouches) do ab = true; break end
    if m == "RMB (PC)" then return rmb end
    if m == "Aim Btn (Mobile)" then return ab end
    return rmb or ab
end
