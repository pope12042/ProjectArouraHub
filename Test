local CUR_CANDS = {{"GetAmmo","meth"},{"Ammo","get"},{"Ammo","field"},{"CurrentAmmo","field"},{"Clip","field"}}
local RES_CANDS = {{"GetReserveAmmo","meth"},{"ReserveAmmo","get"},{"Reserve","get"},{"ReserveAmmo","field"},{"Reserve","field"},{"BackupAmmo","field"}}
local MAX_CANDS = {{"GetMaxAmmo","meth"},{"GetClipSize","meth"},{"MaxAmmo","get"},{"ClipSize","get"},{"MaxAmmo","field"},{"ClipSize","field"}}
local function tryRead(item, desc)
    if desc.kind == "meth" then
        local okv, v = pcall(function() return item[desc.name](item) end)
        if okv and type(v) == "number" then return v end
    elseif desc.kind == "get" then
        local okv, v = pcall(function() return item:Get(desc.name) end)
        if okv and type(v) == "number" then return v end
    else
        local okv, v = pcall(function() return item[desc.name] end)
        if okv and type(v) == "number" then return v end
    end
    return nil
end
local function probe(item, cands)
    for _, c in ipairs(cands) do
        local v = tryRead(item, {name = c[1], kind = c[2]})
        if v ~= nil and v >= 0 then return {name = c[1], kind = c[2]} end
    end
    return nil
end
local ammoProbeCache = {}
pcall(function()
    LocalPlayer.CharacterAdded:Connect(function() ammoProbeCache = {} end)
end)
local function readAmmo(item)
    if not item then return nil end
    local tn = (item.Name or "?") .. "|" .. (typeof(item) == "Instance" and item.ClassName or "t")
    local desc = ammoProbeCache[tn]
    if not desc then
        desc = { cur = probe(item, CUR_CANDS), res = probe(item, RES_CANDS), max = probe(item, MAX_CANDS) }
        ammoProbeCache[tn] = desc
    else
        if desc.cur and tryRead(item, desc.cur) == nil then desc.cur = probe(item, CUR_CANDS) end
        if desc.res and tryRead(item, desc.res) == nil then desc.res = probe(item, RES_CANDS) end
        if desc.max and tryRead(item, desc.max) == nil then desc.max = probe(item, MAX_CANDS) end
    end
    local cur  = desc.cur and tryRead(item, desc.cur)
    local res  = desc.res and tryRead(item, desc.res)
    local maxv = desc.max and tryRead(item, desc.max)
    if cur == nil and res == nil then return nil end
    return cur or 0, res or 0, maxv
end
