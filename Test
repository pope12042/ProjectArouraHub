-- Scan "songs" folder and populate playlist on startup
task.spawn(function()
    if listfiles and isfolder and isfolder("songs") then
        local files = listfiles("songs")
        for _, filePath in ipairs(files) do
            if string.sub(filePath, -4) == ".mp3" then
                local fileName = string.match(filePath, "[^/]+$") or filePath
                fileName = string.match(fileName, "[^\\]+$") or fileName
                local baseName = string.sub(fileName, 1, -5)
                
                local artist = "Unknown"
                local song = baseName
                if string.find(baseName, "_") then
                    local split = {}
                    for part in string.gmatch(baseName, "([^_]+)") do
                        table.insert(split, part)
                    end
                    if #split >= 2 then
                        artist = split[1]
                        table.remove(split, 1)
                        song = table.concat(split, " ")
                    end
                end
                
                -- Fetch lyrics from LRCLIB for each file in folder
                local queryUrl = "https://lrclib.net/api/get?artist_name=" .. HttpService:UrlEncode(artist) .. "&track_name=" .. HttpService:UrlEncode(song)
                local success, res = pcall(function()
                    return request({ Url = queryUrl, Method = "GET" })
                end)
                local lrcLines = {}
                if success && res && res.StatusCode == 200 then
                    local data = HttpService:JSONDecode(res.Body)
                    if data && data.syncedLyrics then
                        lrcLines = parseLRC(data.syncedLyrics)
                    end
                end
                
                table.insert(playlist, {
                    songName = song,
                    artistName = artist,
                    filePath = filePath,
                    lyrics = lrcLines
                })
            end
        end
        refreshLibraryUI()
    end
end)

