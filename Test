local function makeProxy(props, update)
return setmetatable({}, {
__index = function(_, k) return props[k] end,
__newindex = function(_, k, v) props[k] = v update() end,
})
end
Drawing.new = function(class)
if class == "Line" then
local frame = Instance.new("Frame")
frame.AnchorPoint = Vector2.new(0.5, 0.5)
frame.BorderSizePixel = 0
frame.Parent = ScreenGui
local props = { Visible = false, From = Vector2.new(0,0), To = Vector2.new(0,0), Color = Color3.new(1,1,1), Thickness = 1, Transparency = 1 }
local function update()
frame.Visible = props.Visible
frame.BackgroundColor3 = props.Color
frame.BackgroundTransparency = 1 - props.Transparency
local d = (props.To - props.From).Magnitude
local c = (props.From + props.To) / 2
local a = math.atan2(props.To.Y - props.From.Y, props.To.X - props.From.X)
frame.Size = UDim2.fromOffset(d, props.Thickness)
frame.Position = UDim2.fromOffset(c.X, c.Y)
frame.Rotation = math.deg(a)
end
props.Remove = function() frame:Destroy() end
props.Destroy = props.Remove
local p = makeProxy(props, update) update() return p
elseif class == "Square" then
local frame = Instance.new("Frame")
frame.BorderSizePixel = 0
frame.Parent = ScreenGui
local stroke = Instance.new("UIStroke")
stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
stroke.Parent = frame
local props = { Visible = false, Position = Vector2.new(0,0), Size = Vector2.new(0,0), Color = Color3.new(1,1,1), Thickness = 1, Transparency = 1, Filled = false }
local function update()
frame.Visible = props.Visible
frame.Position = UDim2.fromOffset(props.Position.X, props.Position.Y)
frame.Size = UDim2.fromOffset(props.Size.X, props.Size.Y)
frame.BackgroundColor3 = props.Color
frame.BackgroundTransparency = props.Filled and (1 - props.Transparency) or 1
stroke.Color = props.Color
stroke.Thickness = props.Thickness
stroke.Transparency = 1 - props.Transparency
stroke.Enabled = not props.Filled
end
props.Remove = function() frame:Destroy() end
props.Destroy = props.Remove
local p = makeProxy(props, update) update() return p
elseif class == "Circle" then
local frame = Instance.new("Frame")
frame.AnchorPoint = Vector2.new(0.5, 0.5)
frame.BorderSizePixel = 0
frame.Parent = ScreenGui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0)
corner.Parent = frame
local stroke = Instance.new("UIStroke")
stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
stroke.Parent = frame
local props = { Visible = false, Position = Vector2.new(0,0), Radius = 0, Color = Color3.new(1,1,1), Thickness = 1, Transparency = 1, Filled = false, NumSides = 48 }
local function update()
frame.Visible = props.Visible
local d = props.Radius * 2
frame.Size = UDim2.fromOffset(d, d)
frame.Position = UDim2.fromOffset(props.Position.X, props.Position.Y)
frame.BackgroundColor3 = props.Color
frame.BackgroundTransparency = props.Filled and (1 - props.Transparency) or 1
stroke.Color = props.Color
stroke.Thickness = props.Thickness
stroke.Transparency = 1 - props.Transparency
stroke.Enabled = not props.Filled
end
props.Remove = function() frame:Destroy() end
props.Destroy = props.Remove
local p = makeProxy(props, update) update() return p
elseif class == "Triangle" then
local l1 = Instance.new("Frame") l1.BorderSizePixel = 0 l1.Parent = ScreenGui
local l2 = Instance.new("Frame") l2.BorderSizePixel = 0 l2.Parent = ScreenGui
local l3 = Instance.new("Frame") l3.BorderSizePixel = 0 l3.Parent = ScreenGui
local frames = { l1, l2, l3 }
local props = { Visible = false, PointA = Vector2.new(0,0), PointB = Vector2.new(0,0), PointC = Vector2.new(0,0), Color = Color3.new(1,1,1), Thickness = 2, Transparency = 1, Filled = true }
local function seg(fr, a, b)
fr.Visible = props.Visible
fr.BackgroundColor3 = props.Color
fr.BackgroundTransparency = 1 - props.Transparency
local d = (b - a).Magnitude
local c = (a + b) / 2
local ang = math.atan2(b.Y - a.Y, b.X - a.X)
fr.Size = UDim2.fromOffset(d, props.Thickness)
fr.Position = UDim2.fromOffset(c.X, c.Y)
fr.Rotation = math.deg(ang)
fr.AnchorPoint = Vector2.new(0.5, 0.5)
end
local function update()
seg(l1, props.PointA, props.PointB)
seg(l2, props.PointB, props.PointC)
seg(l3, props.PointC, props.PointA)
end
props.Remove = function() for _, fr in ipairs(frames) do fr:Destroy() end end
props.Destroy = props.Remove
local p = makeProxy(props, update) update() return p
elseif class == "Text" then
local label = Instance.new("TextLabel")
label.BackgroundTransparency = 1
label.BorderSizePixel = 0
label.TextYAlignment = Enum.TextYAlignment.Top
label.Parent = ScreenGui
local stroke = Instance.new("UIStroke")
stroke.Thickness = 1
stroke.Transparency = 1
stroke.Parent = label
local props = { Visible = false, Text = "", Position = Vector2.new(0,0), Size = 14, Color = Color3.new(1,1,1), Center = false, Outline = false, OutlineColor = Color3.new(0,0,0), Transparency = 1, Font = 0 }
local function update()
label.Visible = props.Visible
label.Text = props.Text
label.TextSize = props.Size
label.TextColor3 = props.Color
label.TextTransparency = 1 - props.Transparency
label.Position = UDim2.fromOffset(props.Position.X, props.Position.Y)
label.TextXAlignment = props.Center and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
label.Font = fontMap[props.Font] or Enum.Font.SourceSans
stroke.Enabled = props.Outline
stroke.Color = props.OutlineColor
stroke.Transparency = 1 - props.Transparency
end
props.Remove = function() label:Destroy() end
props.Destroy = props.Remove
local p = makeProxy(props, update) update() return p
end
return nil
end
