-- // 7. Aimbot (Silent / Camera / Flickbot / Triggerbot)
local function ResolveAimTarget(cam, maxDist)
    local best, bestScore = nil, math.huge
    local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    local maxDist2 = maxDist * maxDist
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LP then continue end
        if not IsEnemyTeam(player) then continue end
        local char = player.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local aimPartName = Options.AimPart.Value
        local part
        if aimPartName == "Auto" then
            part = char:FindFirstChild("HitboxHead") or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        else
            part = char:FindFirstChild(aimPartName) or char:FindFirstChild("HumanoidRootPart")
        end
        if not part then continue end
        local s, on = cam:WorldToViewportPoint(part.Position)
        if not on then continue end
        local dist2 = (cam.CFrame.Position - part.Position).Magnitude
        if dist2 > maxDist2 then continue end
        local screenDist = (Vector2.new(s.X,s.Y) - center).Magnitude
        local score = screenDist
        if score < bestScore then
            bestScore = score; best = {part=part, player=player, part_pos=part.Position, score=score}
        end
    end
    return best
end

-- Triggerbot target (raycast from crosshair)
local function ResolveTriggerTarget(cam)
    local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    local ray = cam:ViewportPointToRay(center.X, center.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LP.Character}
    local result = Workspace:Raycast(ray.Origin, ray.Direction * 500, params)
    if result and result.Instance then
        local char = result.Instance:FindFirstAncestorOfClass("Model")
        if char then
            local p = Players:GetPlayerFromCharacter(char)
            if p and p ~= LP and IsEnemyTeam(p) then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    return {part = result.Instance, player = p, part_pos = result.Instance.Position}
                end
            end
        end
    end
    return nil
end

