    pcall(function() RunService:UnbindFromRenderStep(RAGE_RESTORE) end)
    if rageAutoDesync and desyncActive then
        desyncActive = false
        pcall(function() if DesyncMod then DesyncMod:Shutdown() end end)
        pcall(function() if Toggles.DesyncToggle then Toggles.DesyncToggle:SetValue(false) end end)
        rageAutoDesync = false
    end
    setStatus("(off)")
end

