do
    local shimGui = Instance.new("ScreenGui")
    shimGui.Name = "VEIL_DRAWING_SHIM"
    shimGui.IgnoreGuiInset = true
    shimGui.DisplayOrder = 999
    local okp, holder = pcall(function() return gethui() end)
    shimGui.Parent = (okp and holder) or game:GetService("CoreGui")
    local FONTS = { [0]=Enum.Font.Gotham, [1]=Enum.Font.SourceSans, [2]=Enum.Font.RobotoMono, [3]=Enum.Font.Code, [4]=Enum.Font.Ubuntu }
    local function fontOf(v)
        if type(v)=="number" then return FONTS[math.clamp(math.floor(v),0,4)] or Enum.Font.Gotham end
        if typeof(v)=="EnumItem" then return v end
        return Enum.Font.Gotham
    end
    local function safe2(v) if typeof(v)~="Vector2" then return nil end if v.X~=v.X or v.Y~=v.Y then return nil end return v end
    local function safeN(v) if type(v)~="number" or v~=v then return nil end return v end
    local function newSquare()
        local f = Instance.new("Frame"); f.BorderSizePixel=0; f.BackgroundTransparency=1; f.Parent=shimGui
        local s = Instance.new("UIStroke"); s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border; s.Thickness=1; s.Parent=f
        return setmetatable({}, {
            __index=function(_,k)
                if k=="Visible" then return f.Visible elseif k=="Color" then return f.BackgroundColor3
                elseif k=="Position" then return Vector2.new(f.Position.X.Offset,f.Position.Y.Offset)
                elseif k=="Size" then return Vector2.new(f.Size.X.Offset,f.Size.Y.Offset)
                elseif k=="Thickness" then return s.Thickness elseif k=="Filled" then return f.BackgroundTransparency<1
                elseif k=="ZIndex" then return f.ZIndex elseif k=="Remove" then return function() f:Destroy() end end
            end,
            __newindex=function(_,k,v)
                if k=="Visible" then f.Visible=v elseif k=="Color" then f.BackgroundColor3=v; s.Color=v
                elseif k=="Position" then local p=safe2(v); if p then f.Position=UDim2.fromOffset(p.X,p.Y) end
                elseif k=="Size" then local p=safe2(v); if p then f.Size=UDim2.fromOffset(math.max(0,p.X),math.max(0,p.Y)) end
                elseif k=="Thickness" then local n=safeN(v); if n then s.Thickness=n end
                elseif k=="Filled" then f.BackgroundTransparency=v and 0 or 1
                elseif k=="ZIndex" then f.ZIndex=v end
            end,
        })
    end
    local function newText()
        local t = Instance.new("TextLabel"); t.BackgroundTransparency=1; t.TextXAlignment=Enum.TextXAlignment.Left; t.TextYAlignment=Enum.TextYAlignment.Top
        t.Text=""; t.TextColor3=Color3.new(1,1,1); t.TextSize=14; t.TextStrokeTransparency=1; t.Parent=shimGui
        return setmetatable({}, {
            __index=function(_,k)
                if k=="Visible" then return t.Visible elseif k=="Text" then return t.Text elseif k=="Color" then return t.TextColor3
                elseif k=="Size" then return t.TextSize elseif k=="Center" then return t.AnchorPoint.X>0
                elseif k=="Middle" then return t.TextYAlignment==Enum.TextYAlignment.Middle
                elseif k=="Outline" then return t.TextStrokeTransparency<1
                elseif k=="Position" then return Vector2.new(t.Position.X.Offset,t.Position.Y.Offset)
                elseif k=="Font" then return t.Font elseif k=="TextBounds" then return t.TextBounds
                elseif k=="RichText" then return t.RichText elseif k=="ZIndex" then return t.ZIndex
                elseif k=="Remove" then return function() t:Destroy() end end
            end,
            __newindex=function(_,k,v)
                if k=="Visible" then t.Visible=v elseif k=="Text" then t.Text=tostring(v) elseif k=="Color" then t.TextColor3=v
                elseif k=="Size" then local n=safeN(v); if n then t.TextSize=math.clamp(n,4,96) end
                elseif k=="Center" then t.AnchorPoint=Vector2.new(v and 0.5 or 0, t.AnchorPoint.Y)
                elseif k=="Middle" then t.TextYAlignment=v and Enum.TextYAlignment.Middle or Enum.TextYAlignment.Top
                elseif k=="Outline" then t.TextStrokeTransparency=v and 0 or 1
                elseif k=="Position" then local p=safe2(v); if p then t.Position=UDim2.fromOffset(p.X,p.Y) end
                elseif k=="Font" then t.Font=fontOf(v) elseif k=="RichText" then t.RichText=v and true or false
                elseif k=="ZIndex" then t.ZIndex=v end
            end,
        })
    end
    local function newLine()
        local f = Instance.new("Frame"); f.BorderSizePixel=0; f.AnchorPoint=Vector2.new(0,0.5); f.Parent=shimGui
        local from, to = Vector2.new(), Vector2.new(); local thick = 1
        local function update()
            local d = to - from; local len = d.Magnitude
            if len ~= len then return end
            f.Size = UDim2.fromOffset(len, thick); f.Position = UDim2.fromOffset(from.X, from.Y)
            f.Rotation = math.deg(math.atan2(d.Y, d.X))
        end
        return setmetatable({}, {
            __index=function(_,k)
                if k=="Visible" then return f.Visible elseif k=="From" then return from elseif k=="To" then return to
                elseif k=="Thickness" then return thick elseif k=="Color" then return f.BackgroundColor3
                elseif k=="Transparency" then return f.BackgroundTransparency elseif k=="ZIndex" then return f.ZIndex
                elseif k=="Remove" then return function() f:Destroy() end end
            end,
            __newindex=function(_,k,v)
                if k=="Visible" then f.Visible=v
                elseif k=="From" then local p=safe2(v); if p then from=p; update() end
                elseif k=="To" then local p=safe2(v); if p then to=p; update() end
                elseif k=="Thickness" then local n=safeN(v); if n then thick=n; update() end
                elseif k=="Color" then f.BackgroundColor3=v
                elseif k=="Transparency" then local n=safeN(v); if n then f.BackgroundTransparency=math.clamp(n,0,1) end
                elseif k=="ZIndex" then f.ZIndex=v end
            end,
        })
    end
    local function newCircle()
        local f = Instance.new("Frame"); f.BorderSizePixel=0; f.BackgroundTransparency=1; f.AnchorPoint=Vector2.new(0.5,0.5); f.Parent=shimGui
        local c = Instance.new("UICorner"); c.Parent=f
        local s = Instance.new("UIStroke"); s.Parent=f
        local radius = 0
        local function applySize() f.Size=UDim2.fromOffset(radius*2,radius*2); c.CornerRadius=UDim.new(0,radius) end
        return setmetatable({}, {
            __index=function(_,k)
                if k=="Visible" then return f.Visible elseif k=="Position" then return Vector2.new(f.Position.X.Offset,f.Position.Y.Offset)
                elseif k=="Radius" then return radius elseif k=="Color" then return f.BackgroundColor3
                elseif k=="Thickness" then return s.Thickness elseif k=="Filled" then return f.BackgroundTransparency<1
                elseif k=="Transparency" then return f.BackgroundTransparency elseif k=="ZIndex" then return f.ZIndex
                elseif k=="Remove" then return function() f:Destroy() end end
            end,
            __newindex=function(_,k,v)
                if k=="Visible" then f.Visible=v
                elseif k=="Position" then local p=safe2(v); if p then f.Position=UDim2.fromOffset(p.X,p.Y) end
                elseif k=="Radius" then local n=safeN(v); if n then radius=math.max(0,n); applySize() end
                elseif k=="Color" then f.BackgroundColor3=v; s.Color=v
                elseif k=="Thickness" then local n=safeN(v); if n then s.Thickness=n end
                elseif k=="Filled" then f.BackgroundTransparency=v and 0 or 1
                elseif k=="Transparency" then local n=safeN(v); if n then f.BackgroundTransparency=math.clamp(n,0,1) end
                elseif k=="ZIndex" then f.ZIndex=v end
            end,
        })
    end
    local function newImage()
        local f = Instance.new("Frame"); f.BorderSizePixel=0; f.BackgroundTransparency=1; f.Parent=shimGui
        local img = Instance.new("ImageLabel"); img.BackgroundTransparency=1; img.Size=UDim2.new(1,0,1,0); img.Parent=f
        return setmetatable({}, {
            __index=function(_,k)
                if k=="Visible" then return f.Visible elseif k=="Color" then return img.ImageColor3
                elseif k=="Position" then return Vector2.new(f.Position.X.Offset,f.Position.Y.Offset)
                elseif k=="Size" then return Vector2.new(f.Size.X.Offset,f.Size.Y.Offset)
                elseif k=="Transparency" then return img.ImageTransparency elseif k=="ZIndex" then return f.ZIndex
                elseif k=="Remove" then return function() f:Destroy() end end
            end,
            __newindex=function(_,k,v)
                if k=="Visible" then f.Visible=v elseif k=="Color" then img.ImageColor3=v
                elseif k=="Position" then local p=safe2(v); if p then f.Position=UDim2.fromOffset(p.X,p.Y) end
                elseif k=="Size" then local p=safe2(v); if p then f.Size=UDim2.fromOffset(math.max(0,p.X),math.max(0,p.Y)) end
                elseif k=="Image" then pcall(function() img.Image=v end)
                elseif k=="Data" then pcall(function() img.Image="rbxassetid://0" end)
                elseif k=="Center" then f.AnchorPoint=Vector2.new(v and 0.5 or 0, v and 0.5 or 0)
                elseif k=="Transparency" then local n=safeN(v); if n then img.ImageTransparency=math.clamp(n,0,1) end
                elseif k=="Filled" then elseif k=="Outline" then elseif k=="ZIndex" then f.ZIndex=v end
            end,
        })
    end
    getgenv().VEIL_SHIM = { api = { new = function(kind)
        if kind=="Square" then return newSquare() elseif kind=="Text" then return newText()
        elseif kind=="Line" then return newLine() elseif kind=="Circle" then return newCircle()
        elseif kind=="Image" then return newImage() end
        return newSquare()
    end } }
end

