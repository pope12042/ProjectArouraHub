local WalkSpeedConn = nil
local function ApplyWalkSpeed()
    if Toggles.WalkSpeed.Value then
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = Options.WalkSpeedVal.Value end
    end
end
local function ApplyJumpPower()
    if Toggles.JumpPower.Value then
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.JumpPower = Options.JumpVal.Value end
    end
end
-- Double jump
UserInputService.JumpRequest:Connect(function()
    if Toggles.DoubleJump.Value then
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)
-- Noclip
local NoclipConn = nil
local function StartNoclip()
    if NoclipConn then NoclipConn:Disconnect() end
    NoclipConn = RunService.Stepped:Connect(function()
        if Toggles.Noclip.Value then
            local char = LP.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end
    end)
end
local function StopNoclip()
    if NoclipConn then NoclipConn:Disconnect(); NoclipConn = nil end
end
-- Auto Strafe
local StrafeConn = nil
local function StartAutoStrafe()
    if StrafeConn then StrafeConn:Disconnect() end
    StrafeConn = RunService.Heartbeat:Connect(function(dt)
        if Toggles.AutoStrafe.Value then
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                -- Auto strafe: move in camera direction
                local cam = workspace.CurrentCamera
                local md = Vector3.new()
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then md = md + cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then md = md - cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then md = md - cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then md = md + cam.CFrame.RightVector end
                if md.Magnitude > 0 then
                    hrp.AssemblyLinearVelocity = md.Unit * 50
                end
            end
        end
    end)
end
local function StopAutoStrafe()
    if StrafeConn then StrafeConn:Disconnect(); StrafeConn = nil end
end

-- // 15. Fast Melee (MeowWC cooldown-zero)
local FastMeleeConn = nil
local function StartFastMelee()
    if FastMeleeConn then FastMeleeConn:Disconnect() end
    FastMeleeConn = RunService.Heartbeat:Connect(function()
        if Toggles.FastMelee.Value then
            local ok = pcall(function()
                local mods = ReplicatedStorage:FindFirstChild("Modules")
                local itemLibMod = mods and mods:FindFirstChild("ItemLibrary")
                if itemLibMod then
                    local ok2, itemLib = pcall(require, itemLibMod)
                    if ok2 and type(itemLib) == "table" and itemLib.Items then
                        for _, item in pairs(itemLib.Items) do
                            pcall(function()
                                rawset(item, "FireRate", 0)
                                rawset(item, "Cooldown", 0)
                                rawset(item, "AttackCooldown", 0)
                                rawset(item, "SwingCooldown", 0)
                                rawset(item, "ThrowCooldown", 0)
                                rawset(item, "RecoverTime", 0)
                                rawset(item, "WindupTime", 0)
                                rawset(item, "ReloadLength", 0)
                            end)
                        end
                    end
                end
            end)
        end
    end)
end
local function StopFastMelee()
    if FastMeleeConn then FastMeleeConn:Disconnect(); FastMeleeConn = nil end
end

-- // 16. Main loop
local lastSkybox = nil
local lastHitSound = nil
RunService.Heartbeat:Connect(function(dt)
    -- Sync toggles
    if Toggles.AutoQueue.Value then StartAutoQueue() else StopAutoQueue() end
    if Toggles.AutoRespawn.Value then StartAutoRespawn() else StopAutoRespawn() end
    if Toggles.AutoTripmine.Value then StartAutoTripmine() else StopAutoTripmine() end
    if Toggles.UnlockAll.Value then StartUnlockAll() else StopUnlockAll() end
    if Toggles.Noclip.Value then StartNoclip() else StopNoclip() end
    if Toggles.AutoStrafe.Value then StartAutoStrafe() else StopAutoStrafe() end
    if Toggles.FastMelee.Value then StartFastMelee() else StopFastMelee() end

    -- WalkSpeed / JumpPower
    ApplyWalkSpeed()
    ApplyJumpPower()

    -- Skybox
    local skyName = Options.SkyboxPreset.Value
    if skyName ~= lastSkybox then
        lastSkybox = skyName
        ApplySkybox(skyName)
    end

    -- Color correction / bloom
    local ccEnabled = Toggles.ColorCorrection.Value
    local bloomEnabled = Toggles.Bloom.Value
    local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
    if ccEnabled then
        if not cc then cc = Instance.new("ColorCorrectionEffect"); cc.Parent = Lighting end
        cc.Enabled = true
        cc.Brightness = Options.CCBright.Value / 100
        cc.Contrast = Options.CCContrast.Value / 100
        cc.Saturation = Options.CCSat.Value / 100
        cc.TintColor = Options.CCTint.Value
    elseif cc then
        cc.Enabled = false
    end
    local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
    if bloomEnabled then
        if not bloom then bloom = Instance.new("BloomEffect"); bloom.Parent = Lighting end
        bloom.Enabled = true
        bloom.Intensity = Options.BloomInt.Value / 10
    elseif bloom then
        bloom.Enabled = false
    end

    -- Reconcile
    ReconcileESP()
    ReconcileThrowables()
    UpdateESP()
    UpdateThrowables()
end)

