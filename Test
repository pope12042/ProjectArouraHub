--[[ FOV RENDERER ]]
local function newFovRenderer()
    local SEG = 32
    local GRAD_SEG = 48
    local INNER = 0.75
    local outline = Drawing.new("Circle")
    outline.Filled = false; outline.NumSides = 96; outline.Thickness = 1.5; outline.Visible = false
    local innerSolid = Drawing.new("Circle")
    innerSolid.Filled = false; innerSolid.NumSides = 96; innerSolid.Thickness = 1; innerSolid.Visible = false
    local innerL = {}; local innerR = {}
    for i = 1, SEG do
        local l = Drawing.new("Line"); l.Thickness = 1.5; l.Visible = false; innerL[i] = l
    end
    for i = 1, SEG do
        local l = Drawing.new("Line"); l.Thickness = 1.5; l.Visible = false; innerR[i] = l
    end
    local gradRing = {}
    for i = 1, GRAD_SEG do
        local l = Drawing.new("Line"); l.Thickness = 2; l.Visible = false; gradRing[i] = l
    end
    local self = {
        visible = false, spin = false, spinSpeed = 60,
        followMode = "Off", followLerp = 0.18, gradient = false,
        cOutline = Color3.fromRGB(255, 255, 255),
        cLeft    = Color3.fromRGB(0, 255, 120),
        cRight   = Color3.fromRGB(120, 0, 255),
        cur = nil, angle = 0, radius = 100, _lastT = nil,
    }
    local function hideAll()
        outline.Visible = false
        innerSolid.Visible = false
        for i = 1, SEG do innerL[i].Visible = false; innerR[i].Visible = false end
        for i = 1, GRAD_SEG do gradRing[i].Visible = false end
    end
    local function drawHalf(arr, startA, col, c, r)
        for i = 1, SEG do
            local a0 = startA + ((i - 1) / SEG) * math.pi
            local a1 = startA + (i / SEG) * math.pi
            local p0 = c + Vector2.new(math.cos(a0), math.sin(a0)) * r
            local p1 = c + Vector2.new(math.cos(a1), math.sin(a1)) * r
            local l = arr[i]; l.From = p0; l.To = p1; l.Color = col; l.Visible = true
        end
    end
    function self.setVisible(v)
        self.visible = v
        if not v then hideAll() end
    end
    function self.update(defaultCenter, targetPos, tipPos, radius)
        self.radius = radius
        if not self.visible then hideAll(); return end
        local now = os.clock()
        local dt = self._lastT and (now - self._lastT) or 0.016
        if dt > 0.1 then dt = 0.1 end
        self._lastT = now
        local goal = defaultCenter
        if self.followMode == "Follow Player" and targetPos then goal = targetPos
        elseif self.followMode == "Follow Gun Tip" and tipPos then goal = tipPos end
        if not self.cur then self.cur = goal end
        self.cur = self.cur:Lerp(goal, self.followLerp)
        if self.spin then self.angle = self.angle + math.rad(self.spinSpeed) * dt end
        local c = self.cur
        if self.gradient then
            for i = 1, GRAD_SEG do
                local a0 = self.angle + ((i - 1) / GRAD_SEG) * (math.pi * 2)
                local a1 = self.angle + (i / GRAD_SEG) * (math.pi * 2)
                local t = (i - 1) / GRAD_SEG
                local col
                if t < 0.5 then col = self.cLeft:Lerp(self.cRight, t * 2)
                else col = self.cRight:Lerp(self.cLeft, (t - 0.5) * 2) end
                local p0 = c + Vector2.new(math.cos(a0), math.sin(a0)) * radius
                local p1 = c + Vector2.new(math.cos(a1), math.sin(a1)) * radius
                local l = gradRing[i]; l.From = p0; l.To = p1; l.Color = col; l.Visible = true
            end
            outline.Visible = false
            innerSolid.Position = c
            innerSolid.Radius = radius * INNER
            innerSolid.Color = self.cOutline
            innerSolid.Visible = true
            for i = 1, SEG do innerL[i].Visible = false; innerR[i].Visible = false end
        else
            for i = 1, GRAD_SEG do gradRing[i].Visible = false end
            innerSolid.Visible = false
            local r = radius * INNER
            drawHalf(innerL, self.angle, self.cLeft, c, r)
            drawHalf(innerR, self.angle + math.pi, self.cRight, c, r)
            outline.Position = c
            outline.Radius = radius
            outline.Color = self.cOutline
            outline.Visible = true
        end
    end
    function self.destroy()
        pcall(function() outline:Remove() end)
        pcall(function() innerSolid:Remove() end)
        for i = 1, SEG do pcall(function() innerL[i]:Remove() end); pcall(function() innerR[i]:Remove() end) end
        for i = 1, GRAD_SEG do pcall(function() gradRing[i]:Remove() end) end
    end
    return self
end
