--[[ SHOOT REMOTE DISCOVERY ]]
do
    local SHOOT_REMOTE_CANDIDATES={"shoot","fire","attack","useitem","replicate","registerhit","dealdamage","applydamage","projectile"}
    local function matchesShootName(n) for _,c in ipairs(SHOOT_REMOTE_CANDIDATES) do if n:find(c,1,true) then return true end end return false end
    local function findShootRemote()
        if SHOOT_STATE.remote then return SHOOT_STATE.remote end
        local remotes=ReplicatedStorage:FindFirstChild("Remotes")
        if not remotes then return nil end
        for _,r in ipairs(remotes:GetDescendants()) do
            if (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) and matchesShootName(r.Name:lower()) then SHOOT_STATE.remote=r return r end
        end
        return nil
    end
    SHOOT_STATE.getTarget=function()
        local R=getgenv().VEIL_RAGE
        if R and R.isEnabled() then local h=R.getTargetHead(); if h and h.Parent then return h end end
        if SilentEnabled then return silentTarget() end
        return nil
    end
    task.spawn(function()
        task.wait(3) findShootRemote()
        if not SHOOT_STATE.remote then
            LocalPlayer.CharacterAdded:Connect(function() task.wait(2); findShootRemote() end)
        end
    end)
end

