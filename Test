pcall(function()
    local B = getgenv().VEIL_BRIDGE
    local Tabs, tab, Options, Toggles = B.Tabs, B.tab, B.Options, B.Toggles
    local Players = game:GetService("Players"); local RunService = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService"); local LocalPlayer = Players.LocalPlayer

    tab("TriggerUI", function()
        local G = Tabs.Trigger:AddLeftGroupbox("triggerbot")
        G:AddToggle("triggerbot_enabled", { Text = "enable", Default = false })
        G:AddLabel("trigger keybind"):AddKeyPicker("triggerbot_keybind", { Default = "MB2", Mode = "Hold", Text = "triggerbot" })
        Toggles.triggerbot_keybind = Options.triggerbot_keybind
        G:AddSlider("triggerbot_max_distance", { Text = "max distance", Default = 500, Min = 10, Max = 2000, Rounding = 0 })
        G:AddSlider("triggerbot_reaction_time", { Text = "reaction time", Default = 0, Min = 0, Max = 500, Rounding = 0 })
        G:AddSlider("triggerbot_reaction_time_offset", { Text = "reaction offset", Default = 0, Min = 0, Max = 200, Rounding = 0 })
        G:AddSlider("triggerbot_shoot_delay", { Text = "shoot delay", Default = 0, Min = 0, Max = 500, Rounding = 0 })
        G:AddDropdown("triggerbot_scoped", { Text = "scoped weapons", Default = {}, Values = {"Revolver", "Rifle", "Sniper", "Shotgun"}, Multi = true })
        G:AddDropdown("triggerbot_part_blacklist", { Text = "part blacklist", Default = {}, Values = {"Head", "HumanoidRootPart"}, Multi = true })
    end)

    local Triggerbot = {}; Triggerbot.__index = Triggerbot
    local HITBOX_NAMES = { "HitboxBody", "HitboxHead", "HitboxHands" }
    function Triggerbot.new(clientFighter, clientItem, input)
        local self = setmetatable({}, Triggerbot)
        self.clientFighter = clientFighter; self.clientItem = clientItem; self.input = input
        self.rayParams = RaycastParams.new(); self.rayParams.FilterType = Enum.RaycastFilterType.Exclude
        local function buildFilter()
            local filter = {}
            local characters = workspace:FindFirstChild("characters")
            if characters then table.insert(filter, characters) end
            local localChar = LocalPlayer.Character
            if localChar then table.insert(filter, localChar) end
            self.rayParams.FilterDescendantsInstances = filter
        end
        local function rayToTarget()
            local cam = workspace.CurrentCamera; if not cam then return nil end
            buildFilter()
            local origin = cam.CFrame.Position; local direction = cam.CFrame.LookVector
            local maxDistance = Options.triggerbot_max_distance.Value
            local result = workspace:Raycast(origin, direction * maxDistance, self.rayParams)
            if not result then return nil end
            local instance = result.Instance; if not instance then return nil end
            local blacklist = Options.triggerbot_part_blacklist.Value or {}
            if blacklist[instance.Name] then return nil end
            local character = instance:FindFirstAncestorOfClass("Model")
            if not character then return nil end
            local hum = character:FindFirstChild("Humanoid")
            if not hum or hum.Health <= 0 then return nil end
            local ally = character:FindFirstChild("_is_ally")
            if ally and ally.Value then return nil end
            for _, name in ipairs(HITBOX_NAMES) do if instance.Name == name then return instance end end
            return nil
        end
        function self:keyHeld()
            local kb = Toggles.triggerbot_keybind
            local mode = kb.Mode or "Hold"; local key = kb.Value
            if mode == "Always" then return true end
            if mode == "Hold" then
                if UserInputService:IsKeyDown(key) then return true end
                if UserInputService.TouchEnabled then
                    local touches = UserInputService:GetTouches()
                    if touches and #touches > 0 then return true end
                end
                return false
            end
            if mode == "Toggle" then if kb.GetState then return kb:GetState() end; return false end
            return true
