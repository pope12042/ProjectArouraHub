local function ShowDamageText(worldPos, damage)
    if not getgenv().Config.ShowDamageText then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local sp, onScreen = cam:WorldToViewportPoint(worldPos)
    if not onScreen or sp.Z <= 0 then return end
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.AnchorPoint = Vector2.new(0.5, 0.5)
    label.Position = UDim2.fromOffset(sp.X, sp.Y)
    label.Size = UDim2.fromOffset(220, 40)
    label.Text = "-" .. tostring(math.floor((tonumber(damage) or 0) + 0.5))
    label.TextColor3 = getgenv().Config.DamageTextColor
    label.TextStrokeTransparency = 0
    label.Font = resolveFont(getgenv().Config.DamageTextFont)
    label.TextSize = 14
    label.ZIndex = 5
    label.Parent = DamageTextGui
    local grow = TweenService:Create(label, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { TextSize = 32 })
    local float = TweenService:Create(label, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.fromOffset(sp.X, sp.Y - 46) })
    grow:Play()
    float:Play()
    task.delay(1.0, function()
        if not label.Parent then return end
        local shrink = TweenService:Create(label, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            TextSize = 12, TextTransparency = 1, TextStrokeTransparency = 1,
        })
        shrink:Play()
        shrink.Completed:Connect(function() label:Destroy() end)
        task.delay(0.4, function() if label.Parent then label:Destroy() end end)
    end)
end

