local stretchBound = false
local stretchCam, stretchBase, stretchResult = nil, nil, nil
RunService:BindToRenderStep("RivalsStretch", Enum.RenderPriority.Camera.Value + 1, function()
    if not getgenv().Config.AspectRatio then
        if stretchBound then
            stretchBound = false
            if stretchCam and stretchCam.Parent and stretchBase and stretchResult and stretchCam.CFrame == stretchResult then
                stretchCam.CFrame = stretchBase
            end
            stretchCam, stretchBase, stretchResult = nil, nil, nil
        end
        return
    end
    local cam = workspace.CurrentCamera
    if not cam then return end
    stretchBound = true
    local y = math.clamp(getgenv().Config.AspectRatioValue, 0.01, 1)
    local base = cam.CFrame
    local result = base * CFrame.new(0, 0, 0, 1, 0, 0, 0, y, 0, 0, 0, 1)
    stretchCam, stretchBase, stretchResult = cam, base, result
    cam.CFrame = result
end)

-- // 9. Silent Aim Hook (your original, UNCHANGED)
local phem2_cs = game:GetService("CollectionService")
local phem7 = require(ReplicatedStorage.Modules.Utility)
local phem8 = phem7.Raycast

function phem9(centerVec)
    local phem10 = centerVec or Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local phem11 = nil
    local phem12 = getgenv().Config.FOVRadius
    for phem13, phem14 in phem2_cs:GetTagged("Entity") do
        if phem14 == LocalPlayer.Character then continue end
        if getgenv().Config.TeamCheck and phem14:GetAttribute("TeamID") == LocalPlayer:GetAttribute("TeamID") then continue end
        local phem15 = phem14:FindFirstChild(getgenv().Config.HitPart, true)
        if not phem15 or not phem15:IsA("BasePart") then continue end
        local phem16, phem17 = Camera:WorldToViewportPoint(phem15.Position)
        if not phem17 then continue end
        local phem18 = (phem10 - Vector2.new(phem16.X, phem16.Y)).Magnitude
        if phem18 < phem12 then
            phem12 = phem18
            phem11 = phem15
        end
    end
    return phem11
end

phem7.Raycast = function(self, phem19, phem20, phem21, phem22, phem23, phem24)
    if not getgenv().Config.AimEnabled or type(phem21) ~= "number" or phem21 < 100 then
        return phem8(self, phem19, phem20, phem21, phem22, phem23, phem24)
    end
    local center = (getgenv().Config.SilentFollow == "Follow Gun Tip") and SmoothGunTipScreen or nil
    local phem25 = phem9(center)
    if not phem25 then return phem8(self, phem19, phem20, phem21, phem22, phem23, phem24) end
    LastSilentTargetPart = phem25
    local phem26 = phem25.Position
    local phem27 = (phem26 - phem19).Unit
    local phem28 = (phem26 - phem19).Magnitude
    if phem28 > phem21 then phem28 = phem21 phem26 = phem19 + (phem27 * phem21) end
    return { Position = phem26, Distance = phem28, Instance = phem25, Material = phem25.Material, Normal = -phem27 }
end

-- // 10. ESP (MY build: fixed near-big/far-small scale, distance, tracers, arrows, visibility colors)
local function enemyOk(player)
    if player == LocalPlayer then return false end
    if not getgenv().Config.TeamCheck then return true end
    local myTeam = LocalPlayer:GetAttribute("TeamID")
    local theirTeam = player:GetAttribute("TeamID")
    if myTeam ~= nil and theirTeam ~= nil then return myTeam ~= theirTeam end
    if LocalPlayer.Team ~= nil and player.Team ~= nil then return LocalPlayer.Team ~= player.Team end
    return true
end

local function espShow(player)
    if player == LocalPlayer then return false end
    if getgenv().Config.ESPTeams then return true end
    return enemyOk(player)
end

local espObjects = {}
local function createESP(player)
    if espObjects[player] then return end
    espObjects[player] = {
        Outline = Drawing.new("Square"),
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        Dist = Drawing.new("Text"),
        HBack = Drawing.new("Square"),
        HFill = Drawing.new("Square"),
        Tracer = Drawing.new("Line"),
        Arrow = Drawing.new("Triangle"),
    }
end
local function hideESP(esp)
    esp.Outline.Visible = false
    esp.Box.Visible = false
    esp.Name.Visible = false
    esp.Dist.Visible = false
    esp.HBack.Visible = false
    esp.HFill.Visible = false
    esp.Tracer.Visible = false
    esp.Arrow.Visible = false
end
local function destroyESP(player)
    local esp = espObjects[player]
    if not esp then return end
    pcall(function() esp.Outline:Remove() end)
    pcall(function() esp.Box:Remove() end)
    pcall(function() esp.Name:Remove() end)
    pcall(function() esp.Dist:Remove() end)
    pcall(function() esp.HBack:Remove() end)
    pcall(function() esp.HFill:Remove() end)
    pcall(function() esp.Tracer:Remove() end)
    pcall(function() esp.Arrow:Remove() end)
    espObjects[player] = nil
end
Players.PlayerRemoving:Connect(function(plr)
    destroyESP(plr)
end)

RunService.RenderStepped:Connect(function()
    local cam = workspace.CurrentCamera
    if not cam then return end
    if not getgenv().Config.ESPEnabled then
        for _, esp in pairs(espObjects) do hideESP(esp) end
        return
    end
    for player, esp in pairs(espObjects) do
        if not espShow(player) then hideESP(esp) end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if espShow(player) then createESP(player) end
    end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart") or nil
    local myRootPos = myRoot and myRoot.Position or nil
    local vpX = cam.ViewportSize.X
    local vpY = cam.ViewportSize.Y
    for player, esp in pairs(espObjects) do
        repeat
            local char = player.Character
            if not char or not espShow(player) then
                hideESP(esp)
                break
            end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum or hum.Health <= 0 then
                hideESP(esp)
                break
            end
            local topWorld = hrp.Position + Vector3.new(0, 3.2, 0)
            local feetWorld = hrp.Position - Vector3.new(0, 3.4, 0)
