-- ==========================================
-- LYRICS ENGINE & SONGS FOLDER SCANNER
-- ==========================================
local function parseLRC(syncedText)
    local lines = {}
    for line in string.gmatch(syncedText, "[^\r\n]+") do
        local min, sec, cent, text = string.match(line, "%[(%d%d):(%d%d)%.(%d%d)%](.*)")
        if not min then
            min, sec, cent, text = string.match(line, "%[(%d%d):(%d%d)%.(%d+)%](.*)")
        end
        if min and sec then
            local totalSeconds = tonumber(min) * 60 + tonumber(sec) + (tonumber(cent) or 0) / 100
            text = string.match(text, "^%s*(.-)%s*$")
            table.insert(lines, {time = totalSeconds, text = text})
        end
    end
    return lines
end

local function updateWorldLyrics(newLineText)
    if newLineText == lastDisplayedLine then return end
    lastDisplayedLine = newLineText
    
    local fadeOut = TweenService:Create(worldTextLabel, TweenInfo.new(0.15), {TextTransparency = 1})
    fadeOut:Play()
    fadeOut.Completed:Connect(function()
        worldTextLabel.Text = newLineText
        local fadeIn = TweenService:Create(worldTextLabel, TweenInfo.new(0.15), {TextTransparency = 0})
        fadeIn:Play()
    end)
end

task.spawn(function()
    while true do
        if isSyncing && #parsedLyrics > 0 then
            local currentTime = tick() - songStartTime
            local activeLine = "♪ . . ."
            
            for _, line in ipairs(parsedLyrics) do
                if line.time <= currentTime then
                    activeLine = line.text
                else
                    break
                end
            end
            
            updateWorldLyrics(activeLine)
        end
        task.wait(0.1)
    end
end)

local function sanitizeFileName(name)
    local clean = string.gsub(name, "[%c%p%s]", "_")
    return string.lower(clean)
end

local function playTrackAtIndex(index)
    if #playlist == 0 then return end
    if index > #playlist then index = 1 end
    if index < 1 then index = #playlist end
    currentIndex = index
    
    local track = playlist[currentIndex]
    songTitleLabel.Text = track.songName
    artistLabel.Text = track.artistName
    miniTitle.Text = track.songName
    parsedLyrics = track.lyrics
    
    if currentSoundInstance then
        currentSoundInstance:Stop()
        currentSoundInstance:Destroy()
    end
    
    local assetId = getcustomasset(track.filePath)
    currentSoundInstance = Instance.new("Sound")
    currentSoundInstance.SoundId = assetId
    currentSoundInstance.Volume = 1
    currentSoundInstance.Parent = SoundService
    currentSoundInstance:Play()
    
    songStartTime = tick()
    isSyncing = true
    playBtn.Text = "⏸"
    miniPlay.Text = "⏸"
end

