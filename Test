if not label.Parent then return end
local shrink = TweenService:Create(label, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
TextSize = 12, TextTransparency = 1, TextStrokeTransparency = 1,
})
